@model RFQ.UI.Domain.ResponseDto.VehicleTypeResponseDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Vehicle";
}
@section Scripts {
    <script src="~/js/Views/Vehicle.js"></script>
}   
<div class="app-toolbar  pt-3 px-lg-3">
    <div class="app-container  container-fluid d-flex flex-stack flex-wrap">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex align-items-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-primary lh-1 fw-bolder fs-2x my-0 me-5">
                    Overview
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold">
                    <li class="breadcrumb-item text-gray-700 fw-bold lh-1">
                        <a href="#" class="text-gray-500"><i class="fa-solid fa-house"></i></a>
                    </li>
                    <li class="breadcrumb-item"><i class="fa-solid fa-chevron-right fs-4 text-gray-700 mx-n1"></i></li>
                    <li class="breadcrumb-item text-primary">
                        Vehicle
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="app-content  px-lg-3">
    <div class="app-container  container-fluid">
        <div class="container my-4">
            <button id="backButton" type="button" class="btn btn-primary" style="display:none">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left-circle-fill" viewBox="0 0 16 16">
                    <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z"></path>
                </svg>
                Back
            </button>
        </div>
        <div id="addVehicleDiv" class="card">
            <div class="card-header border-0 cursor-pointer">
                <div class="card-title m-0">
                    <h3 class="fw-bold m-0">Vehicle</h3>
                </div>
            </div>
            <form class="form" id="vehicleForm" method="post">
                <input type="hidden" id="hdVehicleId" />
                <div class="card-body border-top p-9">
                    <div class="row">
                        <div class="col-xl-6">
                            <div class="row align-items-center mb-10">
                                <label class="form-label col-form-label required fw-semibold fs-6">Vehicle No</label>
                                <div class="col-auto">
                                    <input type="text" id="vehicleNo" class="form-control" placeholder="" oninput="this.value = this.value.toUpperCase()" onkeypress="return AllowAlphaNumericOnly(event)"  maxlength="10"/>
                                </div>
                                <div class="col-auto">
                                    <button id="btnVehicleKyc" type="button" class="btn btn-primary me-2">Get e-KYC</button>
                                </div>
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Vehicle Type</label>
                                <select aria-label="Select a VehicleType" id="ddlVehicleType" class="selectpicker" data-live-search="true" data-width="100%">
                                </select>
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Owner Name</label>
                                <select aria-label="Select a OwnerName" id="ddlOwnerName" class="selectpicker" data-live-search="true" data-width="100%">
                                </select>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Vehicle Category</label>
                                <select aria-label="Select a VehicleCategory" id="ddlVehicleCategory" class="selectpicker" data-live-search="true" data-width="100%">
                                </select>
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Vehicle Capacity</label>
                                <input type="text" id="vehicleCapacity" class="form-control" placeholder="Vehicle Capacity" onkeypress="return isNumber(event)" />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label fw-semibold fs-6">Tracking Provider</label>
                                <select aria-label="Select a TrackingProvider" id="ddlTrackingProvider" class="selectpicker" data-live-search="true" data-width="100%">
                                </select>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="card-body border-top p-9" id="ekycDetails">
                    <div class="card-title m-0 pb-10" id="ekycTitle">
                        <h3 class="fw-bold m-0">e-KYC Details</h3>
                    </div>
                    <div class="row" id="ekycRow">
                        <div class="col-xl-6" id="leftSection">
                            <div class="row" id="vehicleStatusRow">
                                <div class="col-lg-6" id="vehicleStatusCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="vehicleStatusInput">Vehicle Status</label>
                                        <input type="text" id="vehicleStatusInput" class="form-control form-control-solid" placeholder="Vehicle Status" disabled />
                                    </div>
                                </div>
                                <div class="col-lg-6" id="blacklistStatusCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="blacklistStatusInput">Blacklist Status</label>
                                        <input type="text" id="blacklistStatusInput" class="form-control form-control-solid" placeholder="Blacklist Status" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="mb-5" id="regdOwnerDiv">
                                <label class="form-label col-form-label required fw-semibold fs-6" for="regdOwnerInput">Regd. Owner</label>
                                <input type="text" id="regdOwnerInput" class="form-control form-control-solid" placeholder="Regd. Owner" disabled />
                            </div>
                            <div class="row" id="engineChasisRow">
                                <div class="col-lg-6" id="engineNoCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="engineNoInput">Engine No</label>
                                        <input type="text" id="engineNoInput" class="form-control form-control-solid" placeholder="Engine No" disabled />
                                    </div>
                                </div>
                                <div class="col-lg-6" id="chasisNoCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="chasisNoInput">Chasis No</label>
                                        <input type="text" id="chasisNoInput" class="form-control form-control-solid" placeholder="Chasis No" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="row" id="makeModelRow">
                                <div class="col-lg-6" id="makeModelCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="makeModelInput">Make-Model</label>
                                        <input type="text" id="makeModelInput" class="form-control form-control-solid" placeholder="Make-Model" disabled />
                                    </div>
                                </div>
                                <div class="col-lg-6" id="pucExpiryRow">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="pucExpiryInput">PUC Expiry Date</label>
                                        <input type="date" id="pucExpiryInput" class="form-control form-control-solid" placeholder="PUC Expiry Date" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="mb-5" id="financerDiv">
                                <label class="form-label col-form-label required fw-semibold fs-6" for="financerInput">Financer</label>
                                <input type="text" id="financerInput" class="form-control form-control-solid" placeholder="Financer" disabled />
                            </div>
                            <div class="row" id="ownerNpRow">
                                <div class="col-lg-6" id="ownerSerialNoCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="ownerSerialNoInput">Owner Serial No</label>
                                        <input type="text" id="ownerSerialNoInput" class="form-control form-control-solid" placeholder="Owner Serial No" disabled />
                                    </div>
                                </div>
                                <div class="col-lg-6" id="npNoCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="npNoInput">N P No</label>
                                        <input type="text" id="npNoInput" class="form-control form-control-solid" placeholder="N P No" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="mb-5" id="insuranceCoDiv">
                                <label class="form-label col-form-label required fw-semibold fs-6" for="insuranceCoInput">Insurance Co</label>
                                <input type="text" id="insuranceCoInput" class="form-control form-control-solid" placeholder="Insurance Co" disabled />
                            </div>
                            <div class="row" id="verifiedOnRow">
                                <div class="col-lg-6" id="verifiedOnCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="verifiedOnInput">Verified On</label>
                                        <input type="date" id="verifiedOnInput" class="form-control form-control-solid" placeholder="Verified On" disabled />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-6" id="rightSection">
                            <div class="row" id="rtoRegRow">
                                <div class="col-lg-6" id="rtoRegistrationCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="rtoRegistrationInput">RTO Registration</label>
                                        <input type="text" id="rtoRegistrationInput" class="form-control form-control-solid" placeholder="RTO Registration" disabled />
                                    </div>
                                </div>
                                <div class="col-lg-6" id="registrationDateCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="registrationDateInput">Registration Date</label>
                                        <input type="date" id="registrationDateInput" class="form-control form-control-solid" placeholder="Registration Date" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="mb-5" id="permanentAddressDiv">
                                <label class="form-label col-form-label required fw-semibold fs-6" for="permanentAddressInput">Permanent Address</label>
                                <input type="text" id="permanentAddressInput" class="form-control form-control-solid" placeholder="Permanent Address" disabled />
                            </div>
                            <div class="row" id="weightRow">
                                <div class="col-lg-6" id="grossWeightCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="grossWeightInput">Gross Weight</label>
                                        <input type="text" id="grossWeightInput" class="form-control form-control-solid" placeholder="Gross Weight" disabled />
                                    </div>
                                </div>
                                <div class="col-lg-6" id="unladenWeightCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="unladenWeightInput">Unladen Weight</label>
                                        <input type="text" id="unladenWeightInput" class="form-control form-control-solid" placeholder="Unladen Weight" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="row" id="expiryDatesRow">
                                <div class="col-lg-6" id="fitnessExpiryCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="fitnessExpiryInput">Fitness Expiry Date</label>
                                        <input type="date" id="fitnessExpiryInput" class="form-control form-control-solid" placeholder="Fitness Expiry Date" disabled />
                                    </div>
                                </div>
                                <div class="col-lg-6" id="taxExpiryCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="taxExpiryInput">Tax Expiry Date</label>
                                        <input type="date" id="taxExpiryInput" class="form-control form-control-solid" placeholder="Tax Expiry Date" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="row" id="permitRow">
                                <div class="col-lg-6" id="permitNoCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="permitNoInput">Permit No</label>
                                        <input type="text" id="permitNoInput" class="form-control form-control-solid" placeholder="Permit No" disabled />
                                    </div>
                                </div>
                                <div class="col-lg-6" id="permitExpiryCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="permitExpiryInput">Permit Expiry Date</label>
                                        <input type="date" id="permitExpiryInput" class="form-control form-control-solid" placeholder="Permit Expiry Date" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="row" id="npExpiryVehicleCapacityRow">
                                <div class="col-lg-6" id="npExpiryCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="npExpiryInput">NP Expiry Date</label>
                                        <input type="date" id="npExpiryInput" class="form-control form-control-solid" placeholder="NP Expiry Date" disabled />
                                    </div>
                                </div>
                                <div class="col-lg-6" id="vehicleCapacityCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="vehicleCapacityInput">Vehicle Capacity</label>
                                        <input type="text" id="vehicleCapacityInput" class="form-control form-control-solid" placeholder="Vehicle Capacity" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="row" id="policyRow">
                                <div class="col-lg-6" id="policyNoCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="policyNoInput">Policy No</label>
                                        <input type="text" id="policyNoInput" class="form-control form-control-solid" placeholder="Policy No" disabled />
                                    </div>
                                </div>
                                <div class="col-lg-6" id="policyExpiryCol">
                                    <div class="mb-5">
                                        <label class="form-label col-form-label required fw-semibold fs-6" for="policyExpiryInput">Policy Expiry Date</label>
                                        <input type="date" id="policyExpiryInput" class="form-control form-control-solid" placeholder="Policy Expiry Date" disabled />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-start py-4">
                    <button type="button" id="btnSaveVehicle" class="btn btn-primary me-2">Save</button>
                    <button type="button" id="btnSaveNewVehicle" class="btn btn-primary me-2">Save & New</button>
                    <button type="button" id="btnUpdateVehicle" class="btn btn-primary me-2" style="display:none;">Update</button>
                    <button type="button" id="btnView" class="btn btn-primary">View</button>
                    <button type="button" id="cancleButton" class="btn btn-danger d-none">Cancle</button>
                </div>
            </form>
        </div>
        <div class="my-4"></div>
        <div id="tableDiv" class="card card-flush shadow-sm rounded-2xl" style="display:none">
            <div class="card-header p-4">
                <h4 class="fw-bold m-0 text-lg">Vehicle List</h4>
            </div>
            <div class="card-body">
                <table id="tableVehicle" class="table table-striped align-middle fs-6 mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>VehicleNo</th>
                            <th>VehicleStatus</th>
                            <th>EngineNo</th>
                            <th>ChassisNo</th>
                            <th>VehicleCapacity</th>
                            <th>RTORegistration</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Dynamic rows go here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


