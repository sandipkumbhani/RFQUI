@{
    Layout = "_Layout";
    ViewData["Title"] = "VehicleType";
}
@section Scripts {
    <script src="~/js/Views/VehicleType.js"></script>
}
<div class="app-toolbar pt-3 px-lg-3">
    <div class="app-container container-fluid d-flex flex-stack flex-wrap">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex align-items-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-primary lh-1 fw-bolder fs-2x my-0 me-5">
                    Overview
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold">
                    <li class="breadcrumb-item text-gray-700 fw-bold lh-1">
                        <a href="#" class="text-gray-500">
                            <i class="fa-solid fa-house"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <i class="fa-solid fa-chevron-right fs-4 text-gray-700 mx-n1"></i>
                    </li>
                    <li class="breadcrumb-item text-primary">
                        Vehicle Type
                    </li>
                </ul>
            </div>
        </div>
    </div>

</div>

<div class="app-content  px-lg-3">
    <div class="app-container  container-fluid">
        <div class="container my-4">
            <button id="backButton" type="button" class="btn btn-primary" style="display:none">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left-circle-fill" viewBox="0 0 16 16">
                    <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z"></path>
                </svg>
                Back
            </button>
        </div>
        <div id="addVehicleTypeDiv" class="card">
            <div class="card-header border-0 cursor-pointer">
                <div class="card-title m-0">
                    <h3 class="fw-bold m-0">Vehicle Type</h3>
                </div>
            </div>
            <form class="form" id="VehicleTypeForm" method="post">
                <div class="card-body border-top p-9">
                    <div class="row">
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Vehicle Type</label>
                                <input type="text"  class="form-control" id="txtVehicleType"
                                       placeholder="Vehicle Type" maxlength="50" />
                            </div>
                        </div>
                        <div class="col-xl-3">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Minimum KMS / Day</label>
                                <input type="text" inputmode="numeric" class="form-control" id="txtminKmsPerDay"
                                       placeholder="Minimum KMS / Day" />
                            </div>
                        </div>
                    </div>

                </div>
                <div class="card-footer d-flex justify-content-srtat py-6 px-9">
                    <button id="btnSaveVehicleType" type="button" class="btn btn-primary me-2" data-action="save">Save</button>
                    <button id="SavenewButton" type="button" class="btn btn-primary" data-action="saveNew">Save & New</button>&nbsp;
                    <button id="viewButton" type="button" class="btn btn-primary">View</button>
                    <button id="updateButton" type="button" class="btn btn-primary" style="display:none;">Update</button>
                    <button id="cancleButton" type="button" class="btn btn-danger ms-2 d-none">Cancle</button>
                </div>
            </form>
        </div>
        <div class="my-4"></div>
        <!-- Vehicle Type Table Card -->
        <div id="tableDiv" class="card card-flush shadow-sm rounded-2xl" style="display:none">
            <div class="card-header p-4">
                <h4 class="fw-bold m-0 text-lg">Vehicle Type List</h4>
            </div>
            <div class="card-body">
                <table id="tableVehicleType"
                       class="table table-striped align-middle fs-6 mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Company Name</th>
                            <th>Vehicle Type Name</th>
                            <th>Minimum KMS / Day</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Dynamic rows go here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

