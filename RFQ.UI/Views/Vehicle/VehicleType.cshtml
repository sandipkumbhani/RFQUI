@{
    Layout = "_Layout";
    ViewData["Title"] = "VehicleType";
}
<div class="app-toolbar  pt-3 px-lg-3">
    <div class="app-container  container-fluid d-flex flex-stack flex-wrap">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex align-items-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-primary lh-1 fw-bolder fs-2x my-0 me-5">
                    Overview
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold">
                    <li class="breadcrumb-item text-gray-700 fw-bold lh-1">
                        <a href="#" class="text-gray-500"><i class="fa-solid fa-house"></i></a>
                    </li>
                    <li class="breadcrumb-item"><i class="fa-solid fa-chevron-right fs-4 text-gray-700 mx-n1"></i></li>
                    <li class="breadcrumb-item text-primary">
                        Vehicle Type
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="app-content  px-lg-3">
    <div class="app-container  container-fluid">
        <div class="card">
            <div class="card-header border-0 cursor-pointer">
                <div class="card-title m-0">
                    <h3 class="fw-bold m-0">Vehicle Type</h3>
                </div>
            </div>
            <form class="form" id="VehicleTypeForm" method="post">
                <div class="card-body border-top p-9">
                    <div class="row">
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Vehicle Type</label>
                                @* <input type="text" class="form-control" placeholder="Vehicle Type" /> *@
                                <select id="vehicleType" name="vehicleType"
                                        data-control="select2" data-placeholder="Select Vehicle Type" class="form-select select2 form-select-solid form-select-lg fw-semibold">
                                    <option value="">Select Vehicle Type</option>
                                </select>
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Owner Name</label>
                                @* <input type="text" class="form-control" placeholder="Owner Name" /> *@
                                <select id="ownerName" name="OwnerName"
                                        data-control="select2" data-placeholder="Select Owner Name" class="form-select select2 form-select-solid form-select-lg fw-semibold">
                                    <option value="">Select Owner Name</option>
                                </select>
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label fw-semibold fs-6">Tracking Provider</label>
                                @* <input type="text" class="form-control" placeholder="Tracking Provider" /> *@
                                <select id="trackingProvider" name="TrackingProvider"
                                        data-control="select2" data-placeholder="Select Tracking Provider" class="form-select select2 form-select-solid form-select-lg fw-semibold">
                                    <option value="">Select Tracking Provider</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Vehicle Category</label>
                                @* <input type="text" class="form-control" placeholder="Vehicle Category" /> *@
                                <select id="vehicleCategory" name="vehicleCategory"
                                        data-control="select2" data-placeholder="Select Vehicle Category" class="form-select select2 form-select-solid form-select-lg fw-semibold">
                                    <option value="">Select Vehicle Category</option>
                                </select>
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Vehicle Capacity</label>
                                <input type="text" class="form-control" placeholder="Vehicle Capacity" />
                            </div>

                        </div>
                    </div>

                </div>
                <div class="card-footer d-flex justify-content-srtat py-6 px-9">
                    <button type="submit" class="btn btn-primary me-2">Save</button>
                    <button id="SavenewButton" type="submit" class="btn btn-primary">Save & New</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
    const vehicleTypes = ["Car", "Bike", "Truck", "Bus", "Van"];
     const vehicleCategories = ["Sedan", "SUV", "Hatchback", "Pickup", "Convertible"];
    const ownerNames = ["John Doe", "Jane Smith", "Robert Johnson", "Emily Davis", "Michael Brown"];
    const trackingProviders = ["GPS Tracker Inc.", "FleetMonitor", "TrackMe", "GeoLocate", "NavTrack"];
        const trackingDropdown = document.getElementById("trackingProvider");

    // Get the dropdown element
    const dropdown = document.getElementById("vehicleType");
    const categoryDropdown = document.getElementById("vehicleCategory");
     const ownerDropdown = document.getElementById("ownerName");

    // Populate dropdown options
    vehicleTypes.forEach(type => {
        let option = document.createElement("option");
        option.value = type;
        option.textContent = type;
        dropdown.appendChild(option);
    });

    // Populate dropdown options
    vehicleCategories.forEach(category => {
        let option = document.createElement("option");
        option.value = category;
        option.textContent = category;
        categoryDropdown.appendChild(option);
    });

    // Populate dropdown options
    ownerNames.forEach(owner => {
        let option = document.createElement("option");
        option.value = owner;
        option.textContent = owner;
        ownerDropdown.appendChild(option);
    });

      // Populate dropdown options
    trackingProviders.forEach(provider => {
        let option = document.createElement("option");
        option.value = provider;
        option.textContent = provider;
        trackingDropdown.appendChild(option);
    });

     $(document).ready(function() {
            getAndSetToken("AuthToken");
        $("#VehicleTypeForm").submit(function(event) {
            event.preventDefault();
            var saveUrl = '@Url.Content("~/Vehicle/Vehicletypesave")';
            var formData = {
                VehicleTypeName: $("#vehicleType").val(),
            };

            $.ajax({
                url:saveUrl ,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function(response) {
                    console.log("Form submitted successfully!");

                },
                error: function(xhr, status, error) {
                    console.log("Error submitting form");
                }
            });
        });

         $('#SavenewButton').on('click', function () {
                        $('#VehicleTypeForm')[0].reset(); // Reset form fields
         });
    });


       function getAndSetToken(cookieName) {
        var globalUrl = '@Url.Content("~/api/global/set-token")';
        let match = document.cookie.match(new RegExp('(^| )' + cookieName + '=([^;]+)'));
        let token = match ? match[2] : null;
        console.log(token);
        if (token) {
            fetch(globalUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(token)
            })
            .then(response => {
                if (!response.ok) {
                    console.error("Failed to set token");
                } else {
                    console.log("Token successfully set");
                }
            })
            .catch(error => console.error("Error:", error));
        } else {
            console.warn("Token not found in cookies");
        }
    }

</script>

