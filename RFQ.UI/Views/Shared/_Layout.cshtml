    <script>
        $(document).ready(function () {
            $.ajax({
                url: '/Home/GetMenu',
                type: "GET",
                dataType: 'json',
                success: function (response) {
                    let menuList = response.menulistDtos;
                    let sidebarHtml = '';
                    let groupedItems = {};
                    console.log(response);
                    menuList.forEach(item => {
                        if (!groupedItems[item.groupId]) {
                            groupedItems[item.groupId] = {
                                groupName: item.linkGroupName,
                                linkGroupIcon : item.linkGroupIcon,
                                items: []
                            };
                        }
                        groupedItems[item.groupId].items.push(item);
                    });



                    for (let groupId in groupedItems) {
                        let group = groupedItems[groupId];

                    sidebarHtml += '<div class="menu-item menu-accordion">';
                            sidebarHtml += '<span class="menu-link" data-bs-toggle="collapse" data-bs-target="#'+group.groupName+'">';
                            sidebarHtml += '<span class="menu-icon"><i class="bi '+ group.linkGroupIcon + ' fs-1 "></i></span>';
                            sidebarHtml += '<span class="menu-title">' + group.groupName + '</span>';
                            sidebarHtml += '<span class="menu-arrow"></span>';
                            sidebarHtml += '</span>';
                            sidebarHtml += '<div class="menu-sub-accordion">';

                            group.items.forEach(item => {
                                sidebarHtml += '<div id="'+group.groupName+'"  class="menu-item collapse show">';
                                sidebarHtml += '<a href="' + item.linkUrl + '" class="menu-link">';
                                sidebarHtml += '<span class="menu-bullet"><i class="bi '+ item.linkIcon + ' fs-1 "></i></span>';
                                sidebarHtml += '<span class="menu-title">' + item.linkName + '</span>';
                                sidebarHtml += '</a>';
                                sidebarHtml += '</div>';
                            });
                            sidebarHtml += '</div>';
                            sidebarHtml += '</div>';

                    }

                    $('#menuitem').html(sidebarHtml);
                },
                error: function () {
                    console.error("Failed to load menu.");
                }
            });
        });

        function setToken(token) {
            fetch('https://localhost:7295/api/global/set-token', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(token)
            })
            .then(response => {
                if (!response.ok) {
                    console.error("Failed to set token");
                }
            })
            .catch(error => console.error("Error:", error));
        }
    </script>

