@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "RFQ Finalization";
}
@section Scripts {
    <script src="~/js/Views/RFQFinalization.js"></script>
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box add">
            <h1 class="page-title">RFQ Finalization</h1>
        </div>
    </div>
</div>
<div id="AddQuoteRoleVendorDiv" class="card com-profile-info">
    <div class="top-details">
        <form class="row all-custom-class" id="RFQForm" method="post">
            <input type="hidden" id="txtRFQId" />
            <div class="col-xl-4 col-lg-6 col-md-6">
                <div class="item-input">
                    <div class="item-input">
                        <label class="form-label">RFQ No <span>*</span></label>
                        <div class="kyc-input">
                            <input oninput="this.value = this.value.toUpperCase()" type="text" class="form-control" id="txtGstNumber" maxlength="15" placeholder="Enter RFQ No" onkeypress="return AllowAlphaNumericOnly(event)" />
                            <button class="kyc-btn" type="button" id="gstEKycButton">e-KYC</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row all-custom-class">
                <div class="col-lg-6">
                    <div class="item-input">
                        <label class="form-label">Customer Name</label>
                        <select class="select2-custom form-control" data-control="select2" id="ddlCustomerName" style="width: 100%;" disabled>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label">RFQ No</label>
                        <input type="text" class="form-control" placeholder="Auto Generated" id="txtRfqNo" disabled />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label">RFQ Date</label>
                        <input type="datetime-local" class="form-control" id="txtRfqDate" placeholder="Auto Generated" disabled />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label ">RFQ Expired On</label>
                        <input type="datetime-local" onfocus="this.min=new Date().toISOString().slice(0,16)" class="form-control" id="txtRfqExpiredOn" disabled />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label ">Vehicle Req On</label>
                        <input type="date" onfocus="this.min=new Date().toISOString().split('T')[0]" class="form-control" id="txtVehicleReqDate" disabled />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label ">Origin/From</label>
                        <input type="text" class="form-control" id="txtOrigin" placeholder="Map Based Search" disabled />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label">Destination/To</label>
                        <input type="text" class="form-control " placeholder="Map Based Search" id="txtDestination" disabled />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label">Vehicle Type</label>
                        <select class="select2-custom form-control" data-control="select2" id="ddlVehicleType" style="width: 100%;" disabled>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label">No. of Vehicles</label>
                        <input type="text" class="form-control" id="txtNoofVehicles" placeholder="Numeric" disabled />
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="item-input">
                        <label class="form-label">Special Instructions</label>
                        <input type="text" class="form-control" placeholder="Special Instructions" id="txtSpecial" disabled />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label">RFQ Status</label>
                        <input type="text" class="form-control" placeholder="status" id="txtStatus" />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label">Failure Reason</label>
                        <input type="text" class="form-control" placeholder="reason" id="txtReason" />
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="item-input">
                        <label class="form-label">Remarks </label>
                        <input type="text" class="form-control" placeholder="remarks" id="txtremarks" />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label ">Billing Rate </label>
                        <input type="number" class="form-control" placeholder="Numeric" id="txtBillingRate" />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label">Detention Per Day</label>
                        <input type="number" class="form-control" placeholder="Per Day" id="txtPerDay" />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label">Detention Free Days</label>
                        <input type="number" class="form-control" placeholder="Free Days" id="txtFreeDays" />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="item-input">
                        <label class="form-label">Margin Amount</label>
                        <input type="number" class="form-control" placeholder="Amount" id="txtAmount" />
                    </div>
                </div>
            </div>

            <!-- RFQ Sent To Finalization Section -->
            <div class="mt-8">
                <div class="card-header p-4">
                    <h4 class="fw-bold m-0 text-lg">Awarded Vendor Details</h4>
                </div>
                <div class="ard-card">
                    <table id="datatable_ard" class="table table-striped align-middle border rounded fs-6 gy-5 gs-7 dataTable" style="width:100%">
                        <thead>
                            <tr class="fw-semibold fs-6 text-gray-800">
                                <th>Sr. No.</th>
                                <th>Vendor Name</th>
                                <th>PAN No</th>
                                <th>Vendor Rating</th>
                                <th>Mobile No</th>
                                <th>WhatsApp No</th>
                                <th>Email ID</th>
                                <th>Total Hire Cost</th>
                                <th>Detention Per Day</th>
                                <th>Detention Per Days</th>
                                <th>Margin Amount</th>
                                <th>Vendor Position</th>
                                <th>Assign Order</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                            </tr>
                            <tr>
                                <td>3</td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                                <td><input type="text" class="form-control form-control-sm border-primary" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="button-main">
                <a href="#" class="card-link" id="btnSaveCompanyType" type="button" data-action="save">
                    <i class="ri-save-line"></i>
                    <span>
                        Save
                    </span>
                </a>
                <a href="#" class="card-link" id="btnsaveandnew" data-action="saveNew">
                    <i class="ri-save-line"></i>
                    <span>
                        Save & New
                    </span>
                </a>
            </div>
        </form>
    </div>
</div>


