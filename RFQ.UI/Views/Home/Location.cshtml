@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
	Layout = "_Layout";
	ViewData["Title"] = "Location";
}
<div class="app-toolbar  pt-3 px-lg-3">
	<div class="app-container container-fluid d-flex flex-stack flex-wrap">
		<div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
			<div class="page-title d-flex align-items-center gap-1 me-3">
				<h1 class="page-heading d-flex flex-column justify-content-center text-primary lh-1 fw-bolder fs-2x my-0 me-5">
					Dashboard
				</h1>
				<ul class="breadcrumb breadcrumb-separatorless fw-semibold">
					<li class="breadcrumb-item text-gray-700 fw-bold lh-1">
						<a href="#" class="text-gray-500"><i class="fa-solid fa-house"></i></a>
					</li>
					<li class="breadcrumb-item"><i class="fa-solid fa-chevron-right fs-4 text-gray-700 mx-n1"></i></li>
					<li class="breadcrumb-item text-primary">
						Location
					</li>
				</ul>
			</div>
		</div>
	</div>
</div>
<div class="app-content  px-lg-3">
	<div class="app-container  container-fluid">
		<div class="container my-4">
			<button id="backButton" type="button" class="btn btn-primary" style="display:none">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left-circle-fill" viewBox="0 0 16 16">
					<path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z"></path>
				</svg>
				Back
			</button>
		</div>
		<div id="AddLocationDiv" class="card">
			<div class="card-header border-0 cursor-pointer">
				<div class="card-title m-0">
					<h3 class="fw-bold m-0">Location</h3>
				</div>
			</div>
			<form class="form" id="LocationForm" method="post">
				<input type="number" hidden id="txtLocationId" />
				<div class="card-body border-top p-9">
					<div class="row">
						<div class="col-xl-6">
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">Location Name </label>
								<input id="txtLocationName" type="text" class="form-control" placeholder="Location Name" />
							</div>
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">Address </label>
								<input type="text" class="form-control" placeholder="Map Based Search" id="txtAddress" />
							</div>
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">City</label>
								<select name="franchise" aria-label="Select a Franchise/Corporate"
										data-control="select2" data-placeholder="Select a City." id="txtCity" class="form-select select2 form-select-solid form-select-lg fw-semibold">
									<option value="0">Select a City</option>
									<option value="1">Afghanistan</option>
									<option value="2">Aland Islands</option>
									<option value="3">Albania</option>
									<option value="4">Algeria</option>
								</select>
							</div>
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">Contact Person </label>
								<input type="text" class="form-control" placeholder="Contact Person" id="txtPerson" />
							</div>
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">Mobile Number</label>
								<input type="text" class="form-control" placeholder="Mobile Number" id="txtMobileNumber" />
							</div>
						</div>
						<div class="col-xl-6">
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">Location Code</label>
								<input type="text" class="form-control" placeholder="Location Code" id="txtLocationCode" />
							</div>
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">Pincode</label>
								<input type="text" class="form-control" placeholder="Pin Code" id="txtPinCode" />
							</div>
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">WhatsApp Number</label>
								<input type="text" class="form-control" placeholder="WhatsApp Number" id="txtWhatsAppNumber" />
							</div>
							<div class="mb-5">
								<label class="form-label col-form-label fw-semibold fs-6">Email ID</label>
								<input type="email" class="form-control" placeholder="email" id="txtEmail" />
							</div>
						</div>
					</div>
				</div>
				<div class="card-footer d-flex justify-content-srtat py-6 px-9">
					<button type="button" id="btnSaveForm" class="btn btn-primary me-2">Save</button>
					<button type="button" id="btnSaveAndNewForm" class="btn btn-primary me-2">Save & New</button>
					<button type="button" id="btnViewForm" class="btn btn-primary me-2">View</button>
					<button type="button" id="btnUpdate" class="btn btn-primary" style="display:none">Update</button>
				</div>
			</form>
		</div>
		<div class="my-4"></div>
		<div id="tableDiv" class="card card-flush shadow-sm rounded-2xl" style="display:none">
			<div class="card-header p-4">
				<h4 class="fw-bold m-0 text-lg">Location List</h4>
			</div>
			<div class="card-body">
				<table id="tablelocation"
					   class="table table-striped align-middle fs-6 mb-0">
					<thead class="bg-light">
						<tr>
							<th>LocationId</th>
							<th>LocationName</th>
							<th>Action</th>
						</tr>
					</thead>
					<tbody>
						<!-- Dynamic rows go here -->
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="~/js/common.js"></script>
<script>
	var locationResponseDto;
		$(document).on("click","#btnViewForm", function () {
			fetchuserlist();
			$("#AddLocationDiv").css('display', 'none')
			$("#backButton").css('display', 'Block');
		});
	//check validation //FOR NAME
		  $("#txtLocationName").on("blur change",function()
		  {
			 var Textname =$(this).val();
			 if(!isAlphabets(Textname))
			 {
				$("#txtName").val('');
				toastr.warning("Please enter a valid UserName", "Warning");
				return;
			 }
		  });
		  //Address
			$("#txtAddress").on("change", function () {
			var Address = $(this).val();
			if (!isAlphaNumeric(Address)) {
			$("#txtAddress").val('');
			toastr.warning("Please enter a Address", "Warning");
			return;
		}
		});
		//city
		 $("#txtCity").on("change", function () {
				var city = $(this).val();
				if (!isValidateSelect(city)) {
					// $("#txtcity").val('');
					toastr.warning("Please enter a City", "Warning");
					return;
				}
		});
		//contact person
		$("#txtPerson").on("change", function () {
		var person = $(this).val();
		if (!isAlphabets(person)) {
			$("#txtPerson").val('');
			toastr.warning("Please enter a Contact Person", "Warning");
			return;
		}
	});
	//mobile no
	$("#txtContactNumber").on("change", function () {
		var mobileNum = $(this).val();
		if (!isMobile(mobileNum)) {
			 $(this).focus();
			toastr.warning("Please enter a valid 10-digit contact number", "Warning");
			return;
		}
	});
	//Location code
	$("#txtLocationCode").on("change", function () {
		var CompanyCo = $(this).val();
		if (!isAlphabets(CompanyCo)) {
			$("#txtLocationCode").val('');
			toastr.warning("Please enter a Corporate Company Code", "Warning");
			return;
		}
	});
	//pincode
	$("#txtPinCode").on("change", function () {
				var pinc = $(this).val();
				if (!/^\d{6}$/.test(pinc)) {
					$("#txtPinCode").val('');
					toastr.warning("Please enter a Valid Pincode", "Warning");
					return;
				}
	});
	//whatsapp number
	$("#txtWhatsAppNumber").on("change", function () {
		var whats = $(this).val();
		if (!isMobile(whats)) {
			$("#txtWhatsAppNumber").val('');
			toastr.warning("Please enter a whatsApp number", "Warning");


			return;
		}
	});
	//emailid
	$("#txtEmail").on("change", function () {
		var email = $(this).val();
		if (!isValidateEmail(email)) {
			$("#txtEmail").val('');
			toastr.warning("Please enter a valid email", "Warning");
			return;
		}
	});
	  //on form submit
	  $("#btnSaveForm").click(function (event)
	  {
		  event.preventDefault();
		  Save();
	  });
	  //reset button
	  $('#btnSaveAndNewForm').on('click' ,function ()
	  {
		  Save();
		  $('#userbodyform')[0].reset();
	  });
	  //
	  $('#backButton').click(function () {
		$("#AddLocationDiv").css('display', 'Block')
		$("#backButton").css('display', 'none');
		 $('#tableDiv').hide();
	});
</script>