<div id="tableDiv">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box add">
                <h1 class="page-title">Corporate Company</h1>

                <div class="add-btn">
                    <a href="#" id="addCompany">
                        <i class="ri-add-line"></i> <span>Add</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card com-profile-info">
                <!-- Top Header -->
                <div class="table-top-header">
                    <h4>List of Corporate Company</h4>
                    <div class="d-flex gap-2">
                        <div class="table-search-box">
                            <input type="text" id="customcorporateSearch" class="form-control form-control-sm" placeholder="Search...">
                            <button type="submit"><i class="ri-search-line"></i></button>
                        </div>
                        <div class="dropdown">
                            <button class="btn-btn-outline-secondary dropdown-toggle" type="button" id="filterDropdownCorporate" data-bs-toggle="dropdown" aria-expanded="false">
                                Filter <i class="ri-sound-module-line"></i>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="filterDropdownCorporate">
                                <li><a class="dropdown-item filter-option-corporate" data-value="">All Status</a></li>
                                <li><a class="dropdown-item filter-option-corporate" data-value="Pending">Pending</a></li>
                                <li><a class="dropdown-item filter-option-corporate" data-value="Done">Done</a></li>
                            </ul>
                        </div>
                        <div id="exportcorporateButtons" class="btn-group" role="group"></div>
                    </div>
                </div>

                <!-- Table -->
                <div class="table-responsive">
                    <table id="corporateTable" class="table dt-responsive nowrap w-100">
                        <thead>
                            <tr class="text-center">
                                <th class ="text-center">Company Name</th>
                                <th class ="text-center">Address</th>
                                <th class ="text-center">Pincode</th>
                                <th class ="text-center">ContactPerson</th>
                                <th class ="text-center">MobileNumber</th>
                                <th class ="text-center">ContactNumber</th>
                                <th class ="text-center">whatsAppNo</th>
                                <th class ="text-center">Email</th>
                                <th class ="text-center">Pan No</th>
                                <th class ="text-center">GST No</th>

                                <th class="text-center no-sort">Action</th>
                            </tr>
                        </thead>

                        <tbody class="text-center">
                            <!-- Example data -->
                        </tbody>
                    </table>
                </div>

                <!-- Bottom Area -->
                <div class="datatable-footer-bottom">
                    <div class="totle-left">
                        <span id="totalRemindersCorporate">Total List: 3</span>
                    </div>
                    <div id="customcorporatePagination" class="dataTables_paginate paging_simple_numbers"></div>
                    <div class="show-page">
                        <span>Show per page:</span>
                        <select id="pageLength" class="form-select">
                            <option value="5">5 </option>
                            <option value="10" selected>10 </option>
                            <option value="25">25</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="formDiv" style="display:none;">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box add">
                <h1 class="page-title">Corporate Company</h1>

                <div class="add-breadcrumb">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="#" id="tableDivLink">Corporate Company</a></li>
                            <li class="breadcrumb-item active" aria-current="page"> Add Corporate Company</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card com-franchise-info">
                <form class="form" id="CompanyTypeForm" method="post">
                    <input type="hidden" id="txtCompanyId" />
                    <div class="franchise-details">
                        <h2 class="page-form-title">Corporate Company Details</h2>
                        <div class="row all-custom-class">

                            <div class="col-lg-6">
                                <div class="item-input">

                                    <label class="form-label">Company Name <span>*</span> </label>
                                    <input type="text" class="form-control" placeholder="Company Name" maxlength="100" id="txtCompanyName" name="Company Name" />
                                </div>

                            </div>
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label ">Franchise Name <span>*</span></label>
                                    <select class="select2-custom form-control" id="ddlFranchisename" style="width: 100%;">
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="item-input">

                                    <label class="form-label ">Address <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Map Based Search" id="txtAddress" maxlength="200" name="address" />
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label ">City <span>*</span></label>
                                    <select class="select2-custom form-control" id="ddlCity" style="width: 100%;">
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label ">Pincode <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Pin Code" id="txtPinCode" maxlength="6" onkeypress="return isNumber(event)" name="Pincode" />
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label ">Contact Person <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Contact Person" id="txtPerson" maxlength="50" name="Contact Person" />
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <div class="item-input">
                                    <label class="form-label ">WhatsApp Number <span>*</span></label>
                                    <input type="text" class="form-control phone-input" placeholder="+1 (555) 000-0000" id="txtWhatsAppNumber" maxlength="10" onkeypress="return isNumber(event)" name="Whatsapp Number" />

                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label ">Mobile Number <span>*</span></label>
                                    <input type="text" class="form-control phone-input" placeholder="+1 (555) 000-0000" id="txtMobileNumber" maxlength="10" onkeypress="return isNumber(event)" name="Mobile Number" />

                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label"> Contact Number <span>*</span></label>
                                    <input type="text" class="form-control phone-input" placeholder="+1 (555) 000-0000" id="txtContactNumber" maxlength="10" onkeypress="return isNumber(event)" name="Contact Number" />

                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label col-form-label required fw-semibold fs-6">Pan Number <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="xxxxxxxxxx" id="txtPanNumber" maxlength="10" name="Pan Number" onkeypress="return AllowAlphaNumericOnly(event)" />
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label col-form-label fw-semibold fs-6">Email ID <span>*</span></label>
                                    <input type="email" class="form-control" placeholder="email" id="txtEmail" maxlength="50" name="Email" />
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">GST Number <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="xxxxx-xxxxx-xxxxx" id="txtGstNumber" maxlength="15" name="Gst Number" onkeypress="return AllowAlphaNumericOnly(event)" />
                                </div>
                            </div>

                        </div>
                    </div>

                    @await Html.PartialAsync("~/Views/Partials/_AttachmentDetails.cshtml")

                    <div class="button-main">
                        <a href="#" class="card-link" id="btnSaveCompanyType" type="button" data-action="save">
                            <i class="ri-save-line"></i>
                            <span>
                                Save
                            </span>

                        </a>

                        <a href="#" class="card-link" id="btnsaveandnew" data-action="saveNew">
                            <i class="ri-save-line"></i>
                            <span>
                                Save & New
                            </span>
                        </a>
                        <a href="#" class="card-link" id="btnupdate" style="display:none;">
                            <i class="ri-save-line"></i>
                            <span>
                                Update
                            </span>
                        </a>
                        <a href="#" class="card-link" id="btnCancel">
                            <i class="ri-close-line"></i>
                            <span>
                                Cancel
                            </span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
