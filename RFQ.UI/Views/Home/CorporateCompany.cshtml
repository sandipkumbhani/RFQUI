@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "CorporateCompany";
}
@section Scripts {
    <script src="~/js/AttachmentDetails.js"></script>
    <script src="~/js/Views/CorporateCompany.js"></script>
}
@* <head> *@
@*     <!-- Latest compiled and minified CSS --> *@
