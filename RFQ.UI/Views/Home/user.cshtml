@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "user";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RFQ Dashboard</title>
    <link rel="shortcut icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />
    <link href="~/css/plugins.bundle.css" rel="stylesheet" type="text/css" />
    <link href="~/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/all.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="~/css/common.css" rel="stylesheet" type="text/css" />
    <link href="~/css/style.css" rel="stylesheet" type="text/css" />
</head>
<body>

    <div class="d-flex flex-column flex-root app-root">
        <div class="app-page  flex-column flex-column-fluid ">
            <div class="app-header">
                <div class="app-container container-fluid d-flex align-items-stretch flex-stack">
                    <div class="app-navbar flex-lg-grow-1">
                        <div class="app-navbar-item d-flex align-items-stretch flex-lg-grow-1 me-2 me-lg-0">
                            <div class="header-search d-flex align-items-center w-lg-350px">
                                <form class="d-none d-lg-block w-100 position-relative mb-5 mb-lg-0">
                                    <i class="bi bi-search search-icon fs-2 text-gray-500 position-absolute top-50 translate-middle-y ms-5"></i>
                                    <input type="text" class="search-input form-control form-control-solid  ps-13" name="search" value="" placeholder="Search..." />
                                </form>
                            </div>
                        </div>
                        <div class="app-navbar-item ms-1 ms-md-2">
                            <div class="btn btn-icon btn-custom btn-color-gray-600 btn-active-light btn-active-color-primary w-35px h-35px w-md-40px h-md-40px">
                                <i class="bi bi-bell fs-2x"></i>
                            </div>
                            <div class="menu menu-sub-dropdown menu-column w-350px w-lg-375px">
                                <div class="d-flex flex-column bgi-no-repeat rounded-top" style="background-image: url('@Url.Content("~/images/menu-header-bg.jpg")')">
                                    <h3 class="text-white fw-semibold px-9 mt-10 mb-6">
                                        Notifications <span class="fs-8 opacity-75 ps-3">24 reports</span>
                                    </h3>
                                </div>
                            </div>
                        </div>

                        <div class="app-navbar-item me-2 ms-1 ms-md-2">
                            <div class="cursor-pointer symbol symbol-circle symbol-35px ms-3">
                                <img src="~/images/300-3.jpg" alt="user">
                            </div>
                            <div class="menu menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-color fw-semibold py-4 fs-6 w-275px">
                                <div class="menu-item px-3">
                                    <div class="menu-content d-flex align-items-center px-3">
                                        <div class="symbol symbol-50px me-5">
                                            <img alt="Logo" src="~/images/300-3.jpg">
                                        </div>
                                        <div class="d-flex flex-column">
                                            <div class="fw-bold d-flex align-items-center fs-5">
                                                Johnson
                                                <span class="badge badge-light-success fw-bold fs-8 px-2 py-1 ms-2">Pro</span>
                                            </div>
                                            <a href="#" class="fw-semibold text-muted text-hover-primary fs-7">
                                                johnson@kt.com
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="separator my-2"></div>
                                <div class="menu-item px-5">
                                    <a href="#" class="menu-link px-5">
                                        My Profile
                                    </a>
                                </div>
                                <div class="menu-item px-5">
                                    <a href="#" class="menu-link px-5">
                                        My Profile
                                    </a>
                                </div>
                                <div class="menu-item px-5">
                                    <a href="#" class="menu-link px-5">
                                        My Profile
                                    </a>
                                </div>
                                <div class="menu-item px-5">
                                    <a href="#" class="menu-link px-5">
                                        Sign Out
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="app-wrapper flex-column flex-row-fluid">
                <div class="app-sidebar flex-column">
                    <div class="app-sidebar-logo position-relative">
                        <a href="#">
                            <img alt="Logo" src="https://img.logoipsum.com/325.svg" class="h-30px app-sidebar-logo-default theme-light-show">
                            <img alt="Logo" src="https://img.logoipsum.com/327.svg" class="h-20px app-sidebar-logo-minimize">
                        </a>
                        <div class="app-sidebar-toggle btn btn-icon btn-sm btn-color-gray-600 btn-active-color-primary border border-gray-300 h-30px w-30px position-absolute rounded-circle top-50 start-100 translate-middle rotate">
                            <i class="fa-solid fa-chevron-left rotate-180"></i>
                        </div>
                    </div>
                    <div class="app-sidebar-menu overflow-hidden">
                        <div class="app-sidebar-wrapper my-5">
                            <!-- Sidebar navigation-->
                            <nav class="sidebar-nav scroll-sidebar" data-simplebar="">
                                <ul id="sidebarnav" class="menu menu-column menu-rounded menu-sub-indention fw-semibold px-1">
                                    <div class="menu-item">
                                        <span class="menu-icon">
                                            <i class="ti ti-layout-dashboard"></i>
                                        </span>
                                        <span class="menu-title hide-menu p-16">Home</span>
                                    </div>
                                    <div class="menu-item">
                                        <a class="menu-link" href="https://localhost:7295/Home/Dashboard" aria-expanded="false">
                                            <span class="menu-icon"><i class="ti ti-layout-dashboard"></i></span>
                                            <span class="menu-title hide-menu">Dashboard</span>
                                        </a>
                                    </div>
                                    @* Company Dropdown *@
                                    <li class="menu-item menu-accordion">
                                        <a class="menu-link has-arrow" href="#" aria-expanded="false">
                                            <span class="menu-icon"><i class="ti ti-layout-dashboard"></i></span>
                                            <span class="menu-title hide-menu">Company</span>
                                            <span class="menu-arrow"></span>
                                        </a>
                                        <ul class="menu-sub menu-sub-accordion" style="display: none;">
                                            <li class="menu-item">
                                                <a class="menu-link" href="/Home/CorporateCompany">
                                                    <span class="menu-bullet"><span class="bullet bullet-dot"></span></span>
                                                    <span class="menu-title hide-menu">Corporate Company</span>
                                                </a>
                                            </li>
                                            <li class="menu-item">
                                                <a class="menu-link" href="~/Home/CompanyConfiguration">
                                                    <span class="menu-bullet"><span class="bullet bullet-dot"></span></span>
                                                    <span class="menu-title hide-menu">Company Configuration</span>
                                                </a>
                                            </li>
                                            <li class="menu-item">
                                                <a class="menu-link" href="/Home/user">
                                                    <span class="menu-bullet"><span class="bullet bullet-dot"></span></span>
                                                    <span class="menu-title hide-menu">User</span>
                                                </a>
                                            </li>
                                            <li class="menu-item">
                                                <a class="menu-link" href="/Home/Franchise">
                                                    <span class="menu-bullet"><span class="bullet bullet-dot"></span></span>
                                                    <span class="menu-title hide-menu">Franchise</span>
                                                </a>
                                            </li>
                                            <li class="menu-item">
                                                <a class="menu-link" href="/Home/OrganisationLocation">
                                                    <span class="menu-bullet"><span class="bullet bullet-dot"></span></span>
                                                    <span class="menu-title hide-menu">Organisation Location</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </li>

                                    @* Master Dropdown *@
                                    <li class="menu-item menu-accordion">
                                        <a class="menu-link has-arrow" href="javascript:void(0);" aria-expanded="false">
                                            <span class="menu-icon"><i class="ti ti-layout-dashboard"></i></span>
                                            <span class="menu-title hide-menu">Master</span>
                                            <span class="menu-arrow"></span>
                                        </a>
                                        <ul aria-expanded="false" class="menu-sub menu-sub-accordion">
                                            <li class="menu-item">
                                                <a class="menu-link" href="https://localhost:7295/Home/Customer" aria-expanded="false">
                                                    <span class="menu-bullet"><span class="bullet bullet-dot"></span></span>
                                                    <span class="menu-title hide-menu">Customer</span>
                                                </a>
                                            </li>
                                            <li class="menu-item">
                                                <a class="menu-link" href="https://localhost:7295/Home/Vehicle" aria-expanded="false">
                                                    <span class="menu-bullet"><span class="bullet bullet-dot"></span></span>
                                                    <span class="menu-title hide-menu">Vehicle</span>
                                                </a>
                                            </li>
                                            <li class="menu-item">
                                                <a class="menu-link" href="https://localhost:7295/Home/Profile" aria-expanded="false">
                                                    <span class="menu-bullet"><span class="bullet bullet-dot"></span></span>
                                                    <span class="menu-title hide-menu">Profile</span>
                                                </a>
                                            </li>
                                            <li class="menu-item">
                                                <a class="menu-link" href="https://localhost:7295/Home/ProfileRight" aria-expanded="false">
                                                    <span class="menu-bullet"><span class="bullet bullet-dot"></span></span>
                                                    <span class="menu-title hide-menu">Profile Rights</span>
                                                </a>
                                            </li>
                                            <li class="menu-item">
                                                <a class="menu-link" href="https://localhost:7295/Home/Item" aria-expanded="false">
                                                    <span class="menu-bullet"><span class="bullet bullet-dot"></span></span>
                                                    <span class="menu-title hide-menu">Item</span>
                                                </a>
                                            </li>
                                            <li class="menu-item">
                                                <a class="menu-link" href="https://localhost:7295/Home/Vendor" aria-expanded="false">
                                                    <span class="menu-bullet"><span class="bullet bullet-dot"></span></span>
                                                    <span class="menu-title hide-menu">Vendor</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </li>
                                    <li class="menu-item">
                                        <a class="menu-link" href="https://localhost:7295/Home/ResetPassword" aria-expanded="false">
                                            <span class="menu-icon"><i class="ti ti-layout-dashboard"></i></span>
                                            <span class="menu-title hide-menu">Reset Password</span>
                                        </a>
                                    </li>
                                    <li class="menu-item">
                                        <a class="menu-link" href="https://localhost:7295/Home/ChangePassword" aria-expanded="false">
                                            <span class="menu-icon"><i class="ti ti-layout-dashboard"></i></span>
                                            <span class="menu-title hide-menu">Change Password</span>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                            <!-- End Sidebar navigation -->
                        </div>
                    </div>
                </div>
                <div class="app-main flex-column flex-row-fluid">
                    <div class="d-flex flex-column flex-column-fluid">
                        <div class="app-toolbar  pt-3 px-lg-3">
                            <div class="app-container  container-fluid d-flex flex-stack flex-wrap">
                                <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
                                    <div class="page-title d-flex align-items-center gap-1 me-3">
                                        <h1 class="page-heading d-flex flex-column justify-content-center text-gray-900 lh-1 fw-bolder fs-2x my-0 me-5">
                                            Dashboard
                                        </h1>
                                        <ul class="breadcrumb breadcrumb-separatorless fw-semibold">
                                            <li class="breadcrumb-item text-gray-700 fw-bold lh-1">
                                                <a href="#" class="text-gray-500"><i class="fa-solid fa-house"></i></a>
                                            </li>
                                            <li class="breadcrumb-item"><i class="fa-solid fa-chevron-right fs-4 text-gray-700 mx-n1"></i></li>
                                            <li class="breadcrumb-item text-gray-700">
                                                User Profile
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="app-content  px-lg-3">
                            <div class="app-container  container-fluid">
                                <div class="card">
                                    <div class="card-header border-0 cursor-pointer">
                                        <div class="card-title m-0">
                                            <h3 class="fw-bold m-0">User</h3>
                                        </div>
                                    </div>
                                    <form class="form">
                                        <div class="card-body border-top p-9">
                                            <div class="row">
                                                <div class="col-xl-6">
                                                    <div class="mb-10">
                                                        <label class="form-label col-form-label required fw-semibold fs-6">User Name </label>
                                                        <input type="text" class="form-control" placeholder="User Name" />
                                                    </div>
                                                    <div class="mb-10">
                                                        <label class="form-label col-form-label required fw-semibold fs-6">Franchise/Corporate Name</label>

                                                        <select name="franchise" aria-label="Select a Franchise/Corporate"
                                                                data-control="select2" data-placeholder="Select a Franchise/Corporate..." class="form-select select2 form-select-solid form-select-lg fw-semibold">
                                                            <option value="">Select a Franchise/Corporate...</option>
                                                            <option value="AF">Afghanistan</option>
                                                            <option value="AX">Aland Islands</option>
                                                            <option value="AL">Albania</option>
                                                            <option value="DZ">Algeria</option>
                                                        </select>
                                                    </div>
                                                    <div class="mb-10">
                                                        <label class="form-label col-form-label required fw-semibold fs-6">Mobile No</label>
                                                        <input type="text" class="form-control" placeholder="Mobile No" />
                                                    </div>
                                                </div>
                                                <div class="col-xl-6">
                                                    <div class="mb-10">
                                                        <label class="form-label col-form-label required fw-semibold fs-6">Login Name</label>
                                                        <input type="text" class="form-control" placeholder="Login Name" />
                                                    </div>
                                                    <div class="mb-10">
                                                        <label class="form-label col-form-label required fw-semibold fs-6">Location</label>
                                                        <select name="location" aria-label="Select a Location"
                                                                data-control="select2" data-placeholder="Select a location..." class="form-select select2 form-select-solid form-select-lg fw-semibold">
                                                            <option value="">Select a location...</option>
                                                            <option value="AF">Afghanistan</option>
                                                            <option value="AX">Aland Islands</option>
                                                            <option value="AL">Albania</option>
                                                            <option value="DZ">Algeria</option>
                                                        </select>
                                                    </div>
                                                    <div class="mb-10">
                                                        <label class="form-label col-form-label fw-semibold fs-6">Email ID</label>
                                                        <input type="email" class="form-control" placeholder="name@example.com" />
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                        <div class="card-footer d-flex justify-content-srtat py-6 px-9">
                                            <button type="submit" class="btn btn-primary me-2">Save</button>
                                            <button type="submit" class="btn btn-primary">Save & New</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="app-footer px-lg-3 ">
                        <div class="app-container  container-fluid d-flex flex-column flex-md-row flex-center flex-md-stack py-3">
                            <div class="text-gray-900 order-2 order-md-1">
                                <span class="text-muted fw-semibold me-1">2025©</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/plugins.bundle.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/script.js"></script>
</body>
</html>