@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
	Layout = "_Layout";
	ViewData["Title"] = "user";
}


<div class="app-toolbar  pt-3 px-lg-3">
	<div class="app-container container-fluid d-flex flex-stack flex-wrap">
		<div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
			<div class="page-title d-flex align-items-center gap-1 me-3">
				<h1 class="page-heading d-flex flex-column justify-content-center text-primary lh-1 fw-bolder fs-2x my-0 me-5">
					Dashboard
				</h1>
				<ul class="breadcrumb breadcrumb-separatorless fw-semibold">
					<li class="breadcrumb-item text-gray-700 fw-bold lh-1">
						<a href="#" class="text-gray-500"><i class="fa-solid fa-house"></i></a>
					</li>
					<li class="breadcrumb-item"><i class="fa-solid fa-chevron-right fs-4 text-gray-700 mx-n1"></i></li>
					<li class="breadcrumb-item text-primary">
						User Profile
					</li>
				</ul>
			</div>
		</div>
	</div>
</div>
<div class="app-content  px-lg-3">
	<div class="app-container  container-fluid">
		<div class="container my-4">
			<button id="backButton" type="button" class="btn btn-primary" style="display:none">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left-circle-fill" viewBox="0 0 16 16">
					<path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z"></path>
				</svg>
				Back
			</button>
		</div>
		<div id="adduserdiv" class="card">
			<div class="card-header border-0 cursor-pointer">
				<div class="card-title m-0">
					<h3 class="fw-bold m-0">User</h3>
				</div>
			</div>
			<form class="form" id="userbodyform" method="post">
				<input type="number" hidden id="txtuserid" />
				<div class="card-body border-top p-9">
					<div class="row">
						<div class="col-xl-6">
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">User Name </label>
								<input id="txtName" type="text" class="form-control" minlength="4" maxlength="12" placeholder="User Name" />
							</div>
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">Password</label>
								<input type="password" class="form-control" minlength="8" maxlength="12" placeholder="password" id="txtPassword" />
							</div>
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">Franchise/Corporate Name</label>
								<select name="franchise" aria-label="Select a Franchise/Corporate"
										data-control="select2" data-placeholder="Select a Franchise/Corporate..." id="txtCompanyAndFranchiseName"  class="form-select select2 form-select-solid form-select-lg fw-semibold">
									<option value="0">Select a Franchise/Corporate...</option>
									@* <option value="1">Afghanistan</option> *@
									@* <option value="2">Aland Islands</option> *@
									@* <option value="3">Albania</option> *@
									@* <option value="4">Algeria</option> *@
								</select>
							</div>
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">Mobile No</label>
								<input type="text" class="form-control" maxlength="10" placeholder="Mobile No" id="txtMobileNo" onkeypress="return isNumber(event)" />
							</div>
						</div>
						<div class="col-xl-6">
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">Login Name</label>
								<input type="text" class="form-control" maxlength="12" placeholder="Login Name" id="txtLoginName" />
							</div>
							<div class="mb-5">
								<label class="form-label col-form-label fw-semibold fs-6">Email ID</label>
								<input type="email" class="form-control" placeholder="name@example.com" id="txtEmailid" />
							</div>
							<div class="mb-5">
								<label class="form-label col-form-label required fw-semibold fs-6">Location</label>
								<select name="location" aria-label="Select a Location"
										data-control="select2" data-placeholder="Select a location..." id="txtLocation" class="form-select select2 form-select-solid form-select-lg fw-semibold">
									<option value="0">Select a location...</option>
									@* <option value="1">Afghanistan</option> *@
									@* <option value="2">Aland Islands</option> *@
									@* <option value="3">Albania</option> *@
									@* <option value="4">Algeria</option> *@
								</select>
							</div>

						</div>
					</div>
				</div>
				<div class="card-footer d-flex justify-content-srtat py-6 px-9">
					<button type="button" id="btnSaveForm" class="btn btn-primary me-2">Save</button>
					<button type="button" id="btnSaveAndNewForm" class="btn btn-primary me-2">Save & New</button>
					<button type="button" id="btnViewForm" class="btn btn-primary me-2">View</button>
					<button type="button" id="btnUpdate" class="btn btn-primary" style="display:none">Update</button>
				</div>
			</form>
		</div>
		<div class="my-4"></div>
		<div id="tableDiv" class="card card-flush shadow-sm rounded-2xl" style="display:none">
			<div class="card-header p-4">
				<h4 class="fw-bold m-0 text-lg">User List</h4>
			</div>
			<div class="card-body">
				<table id="tableuser"
					   class="table table-striped align-middle fs-6 mb-0">
					<thead class="bg-light">
						<tr>
							<th>UserId</th>
							<th>UserName</th>
							<th>MobileNo</th>
							<th>EmailId</th>
							@* <th>Location</th>  *@
							<th>Action</th>
						</tr>
					</thead>
					<tbody>
						<!-- Dynamic rows go here -->
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="~/js/common.js"></script>
<script>
	 // View Button click Call Api
		var userResponseDto;
		$(document).on("click","#btnViewForm", function () {
			fetchuserlist();
			$("#adduserdiv").css('display', 'none')
			$("#backButton").css('display', 'Block');
		});
		 //check validation //FOR USERNAME
		  $("#txtName").on("blur change",function()
		  {
			 var Textname =$(this).val();
			 if(!isAlphabets(Textname))
			 {
				$("#txtName").val('');
				toastr.warning("Please enter a valid UserName", "Warning");
				return;
			 }
		  });
		  //FOR SELECT CORPORATENAME
		   $("#txtCompanyAndFranchiseName").on("blur change",function()
		   {
			   var corporatename =$(this).val();
			   if(!isValidateSelect(corporatename))
			   {
				   //$("#txtCompanyAndFranchiseName").val('');
				   toastr.warning("Please select a valid CorporateName", "Warning");
				   return;
			   }
		   });
		  //FOR MOBILENO
		  $("#txtMobileNo").on("blur change",function()
		  {
			 var mobileno =$(this).val();
			 if(!isMobile(mobileno))
			 {
				//$("#txtMobileNo").val('');
				 $(this).focus();
				toastr.warning("Please enter a valid MobileNumber", "Warning");
				return;
			 }
		  });
		  //FOR LOGINNAME
		  $("#txtLoginName").on("blur change",function()
		  {
			 var loginname =$(this).val();
			 //if(!isAlphabets(txtLoginName))
			 if (!/^[a-zA-Z0-9\x40!#$%^&*(),.?":{}|<>]+$/.test(loginname))
			 {
				$("#txtLoginName").val('');
				toastr.warning("Please enter a valid LoginName", "Warning");
				return;
			 }
		  });
		  //FOR LOCATION
			$("#txtLocation").on("blur change",function()
		   {
			   var location =$(this).val();
			   if(!isValidateSelect(location))
			   {
				   //$("#txtLocation").val('');
				   toastr.warning("Please select a valid Location", "Warning");
				   return;
			   }
		   });
		   //FOR EMAILID
		   $("#txtEmailid").on("blur change",function()
		   {
			   var emailid =$(this).val();
			   if(!isValidateEmail(emailid))
			   {
				   $("#txtEmailid").val('');
				   toastr.warning("Please enter a valid Email", "Warning");
				   return;
			   }
		   });
		   //FOR PASSWORD
		   $("#txtPassword").on("blur change",function()
		   {
			   var password =$(this).val();
			   if (!/^[a-zA-Z0-9\x40!#$%^&*(),.?":{}|<>]+$/.test(password))
			   //if(!isAlphaNumeric(password))
			   {
				   $("#txtPassword").val('');
				   toastr.warning("Please enter a valid PASSWORD", "Warning");
				   return;
			   }
		   });
		  //on form submit
		  $("#btnSaveForm").click(function (event)
		  {
			  event.preventDefault();
			  Save();
		  });
		  //reset button
		  $('#btnSaveAndNewForm').on('click' ,function ()
		  {
			  Save();
			  $('#userbodyform')[0].reset();
		  });
		  //
		  $('#backButton').click(function () {
			$("#adduserdiv").css('display', 'Block')
			$("#backButton").css('display', 'none');
			 $('#tableDiv').hide();
		});

	function fetchuserlist()
	{
		$('#tableDiv').show();
		//var fetchuserlistUrl = '@Url.Content("~/Home/ViewUserList")';
		$.ajax({
			url: '/Home/ViewUserList',
			type: "GET",
			dataType: "json",
			success: function (response) {
				let trlist = response;
				userResponseDto = response;
				// Destroy existing DataTable if exists
				if ($.fn.DataTable.isDataTable('#tableuser')) {
					$('#tableuser').DataTable().clear().destroy();
				}
				$('#tableuser').DataTable({
					"processing": true,
					"serverSide": false,
					"paging": true,
					"pageLength": 10,
					"lengthChange": true,
					"searching": true,
					"ordering": true,
					"info": true,
					"autoWidth": true,
					"responsive": true,
					"info": true,
					"autoWidth": true,
					"responsive": true,
					// "scrollX": true,
					"data": trlist,
					"columns": [
						{ "data": "userId" },
						{ "data": "personName" },
						{ "data": "mobileNo" },
						{ "data": "emailId" },
						// { "data": "location" },
						{
						"data": "userId",
						"render": function (data, type, row) {
							return `
								<div class="btn-group" role="group">
								<button type="button" class="btn btn-sm btn-primary"
								onclick="edituserlist(${data})">
								<i class="ti ti-edit"></i> Edit
								</button>
								<button type="button" class="btn btn-sm btn-danger"
								onclick="deleteuserlist(${data})">
								<i class="ti ti-trash"></i> Delete
								</button>
							   </div>`;
							}
						},
					],
					"columnDefs": [
						{
							"targets": "_all",
							"className": "text-center"
						}
					]
				});
			},
			error: function (xhr, status, error) {
				console.error("Error:", error);
				toastr.error("Failed to fetch data!", "Error");
			}
		});
	}
	function Save()
	{
		   var username = $('#txtName').val();
		   var corporatename = $('#txtCompanyAndFranchiseName').val();
		   var mobileno = $('#txtMobileNo').val();
		   var loginname = $('#txtLoginName').val();
		   var location = $('#txtLocation').val();
		   var emailid = $('#txtEmailid').val();
		   var password = $('#txtPassword').val();

		   if(!isAlphabets(username))
		   {
			  toastr.warning("Please enter a valid UserName", "Warning");
			  return;
		   }
		   if(!isValidateSelect(corporatename))
		   {
			  toastr.warning("Please select a valid CorporateName", "Warning");
			  return;
		   }
		   if(!isMobile(mobileno))
		   {
			   toastr.warning("Please enter a valid MobileNumber", "Warning");
			   return;
		   }
		   if (!/^[a-zA-Z0-9\x40!#$%^&*(),.?":{}|<>]+$/.test(loginname))
		   //if(!isAlphabets(loginname))
		   {
			  toastr.warning("Please enter a valid LoginName", "Warning");
			  return;
		   }
		   if(!isValidateSelect(location))
		   {
			  toastr.warning("Please select a valid Location", "Warning");
			  return;
		   }
		   if(!isValidateEmail(emailid))
		   {
			  toastr.warning("Please enter a valid Email", "Warning");
			  return;
		   }
		   if (!/^[a-zA-Z0-9\x40!#$%^&*(),.?":{}|<>]+$/.test(password))
		   //if(!isAlphaNumeric(password))
		   {
			  toastr.warning("Please enter a valid password", "Warning");
			  return;
		   }
			 var formdata ={
				PersonName :username,
				LoginId:loginname,
				Mobileno:mobileno,
				CompanyId:corporatename,
				LocationId:location,
				Emailid:emailid,
				Password:password
				};
			 console.log(formdata)
			 $.ajax({
				 url:'/Home/UserSave/',
				 type:"POST",
				 contentType:"application/json",
				 dataType: "json",
				 data: JSON.stringify(formdata),
				 success:function(response)
				 {
					  console.log(response);
					  toastr.success("User submitted successfully!");
				 },
				 error: function (req, status, error)
				 {
					  console.log(error);
				 }
			 });
	}
	//For Comp&Fran
	var GetUrl = '@Url.Content("~/Home/GetAllCompanyAndFranchise")';
	$.ajax({
		url: GetUrl,
		type: "GET",
		contentType: "application/json",
		success: function (response) {
			console.log(response);
			var data = response.filter(x=>x.companyTypeId == 2 || x.companyTypeId == 3);
			console.log(data);
				if (data && data.length > 0) {
					$.each(data, function (index, item) {
						$('#txtCompanyAndFranchiseName').append($('<option>', {
							value: item.companyId,
							text: item.companyName
					}));
				});
				}
				else {
					$('#txtCompanyAndFranchiseName').empty().append('<option value="">No Company and Franchise Available</option>');
				}
		},
		error: function (xhr, status, error) {
			console.error("Error:", error);
			toastr.error("Failed to submit company and franchise ", "Error");
		}
	});
	//For Location
	var GetUrl = '@Url.Content("~/Home/GetAllLocation")';
	$.ajax({
		url: GetUrl,
		type: "GET",
		contentType: "application/json",
		success: function (response) {
			debugger;
			console.log(response);
			var data = response.filter(x=>x.locationId)
			console.log(data);
				if (data && data.length > 0) {
					$.each(data, function (index, item) {
						$('#txtLocation').append($('<option>', {
							value: item.locationId,
							text: item.locationName
					}));
				});
				}
				else {
					$('#txtLocation').empty().append('<option value="">No location Available</option>');
				}
							
		},
		error: function (xhr, status, error) {
			console.error("Error:", error);
			toastr.error("Failed to submit company and franchise ", "Error");
		}
	});


	$(document).ready(function ()
	{
		$("#btnUpdate").click(function (e)
		{
			e.preventDefault();
			var UserViewModel = {
				UserId : $('#txtuserid').val(),
				PersonName : $('#txtName').val(),
				CompanyId :  $('#txtCompanyAndFranchiseName').val(),
				Password:  $('#txtPassword').val(),
				LocationId: $('#txtLocation').val(),
				LoginId: $('#txtLoginName').val(),
				Mobileno: $('#txtMobileNo').val(),
				Emailid: $('#txtEmailid').val(),
		}
		var edituserlist = '@Url.Action("EditUserList", "Home")';
		$.ajax({
			type:"PUT",
			url:edituserlist,
			contentType: "application/json; charset=utf-8",
			data: JSON.stringify(UserViewModel),
			dataType: "json",
			success: function (result)
			{
				if (result.result == "success")
				{
					  $("#adduserdiv").css('display','none')
					 //$("#dataDiv").html("User updated successfully!");
					 fetchuserlist();
				}
				else
				{
					$("#dataDiv").html("Failed to update profile.");
				}
				$("#btnSaveForm").show();
				$("#btnUpdate").hide();
				$("#btnSaveAndNewForm").prop("disabled", false);
				//$("#txtPassword").prop("disabled", true);
				$("#btnViewForm").click();
			},
			error: function (xhr, status, error)
			{
				$("#dataDiv").html("Error: " + status + " " + error + " " + xhr.status + " " + xhr.statusText);
			}
		});
	});
	});
	function edituserlist(userId)
	{
		console.log(userResponseDto);
		var data = userResponseDto.filter(x=>x.userId == userId);
		var formdata=data[0];
		console.log(data);
		$("#tableDiv").hide();
		$("#backButton").css('display','none');
		$("#adduserdiv").css('display','Block');
		$("#btnSaveForm").hide();
		$("#btnUpdate").show();
		$("#btnSaveAndNewForm").prop("disabled", true);
		$('#txtuserid').val(formdata.userId);
		$("#txtName").val(formdata.personName);
		$("#txtEmailid").val(formdata.emailId);
		$("#txtCompanyAndFranchiseName").val(formdata.companyId);
		$("#txtMobileNo").val(formdata.mobileNo);
		$("#txtLoginName").val(formdata.loginId);
		$("#txtLocation").val(formdata.locationId);
		$('#txtPassword').val(formdata.password);
		//$('#txtPassword').hide();
		$("#txtPassword").prop("disabled", true);

	}

	function deleteuserlist(userId)
	{
		 var deleteuserlist = '@Url.Content("~/Home/DeleteUserList/")' + userId
		 $.ajax({
			url: deleteuserlist,
			type:"DELETE",
			dataType:"json",
			data:JSON.stringify(userId),
			success: function (response)
			{
				fetchuserlist();
				console.log("Deleted successfullyy...")
			},
			error: function (xhr, status, error) {
				console.error("Error:", error);
				toastr.error("Failed to fetch data!", "Error");
			}
		});
	}
</script>