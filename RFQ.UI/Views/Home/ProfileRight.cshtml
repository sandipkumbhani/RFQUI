@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "ProfileRight";
}

<div class="app-content px-lg-3">
    <div class="app-container container-fluid">

        <div class="card">

            <!-- Card Header -->
            <div class="card-header border-0 cursor-pointer">
                <div class="card-title m-0">
                    <h3 class="fw-bold m-0">Profile Rights</h3>
                </div>
            </div>

            <!-- Profile Name Selection -->

            <div class="card-body border-top p-9">
                <div class="row">
                    <div class="col-xl-6">
                        <div class="mb-5">
                            <label class="form-label">* Profile Name:</label>
                            <select class="form-select">
                                <option>Selection Box</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-6">
                        <div class="mb-5">
                            <label class="form-label">* Menu Group:</label>
                            <select class="form-select">
                                <option>Selection Box</option>
                            </select>
                        </div>
                    </div>
                </div>

            </div>

            <div class="card-body p-9">
                <div class="row">
                    <!-- Select All Checkbox -->
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="selectAll">
                        <label class="form-check-label" for="selectAll">Select All</label>
                    </div>

                    <!-- Menu Items -->
                    @for (var i = 1; i <= 5; i++)
                    {
                        <div class="mb-3">
                            <label class="form-check-label">Menu Item @i: </label> 
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="view@(i)">
                                    <label class="form-check-label" for="view@(i)">View</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="add@(i)">
                                    <label class="form-check-label" for="add@(i)">Add</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="edit@(i)">
                                    <label class="form-check-label" for="edit@(i)">Edit</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="cancel@(i)">
                                    <label class="form-check-label" for="cancel@(i)">Cancel</label>
                                </div>
                        </div>
                    }

                    <div class="card-footer d-flex justify-content-srtat py-6 px-9">
                        <button id="save_click" type="button" class="btn btn-primary me-2">Save</button>
                        <button id="save&new_click" type="button" class="btn btn-primary">Save & New</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>