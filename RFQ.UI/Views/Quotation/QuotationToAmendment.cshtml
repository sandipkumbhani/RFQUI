@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quotation To Customer - Amendment";
}

<div class="app-toolbar  pt-3 px-lg-3">
    <div class="app-container  container-fluid d-flex flex-stack flex-wrap">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex align-items-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-primary lh-1 fw-bolder fs-2x my-0 me-5">
                    Overview
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold">
                    <li class="breadcrumb-item text-gray-700 fw-bold lh-1">
                        <a href="#" class="text-gray-500"><i class="fa-solid fa-house"></i></a>
                    </li>
                    <li class="breadcrumb-item"><i class="fa-solid fa-chevron-right fs-4 text-gray-700 mx-n1"></i></li>
                    <li class="breadcrumb-item text-primary">
                        Quotation To Customer - Amendment
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="app-content  px-lg-3">
    <div class="app-container  container-fluid">
        <div class="card">
            <div class="card-header border-0 cursor-pointer">
                <div class="card-title m-0">
                    <h3 class="fw-bold m-0"> Quotation To Customer - Amendment</h3>
                </div>
            </div>
            <form class="form" id="RfqVendorForm">
                <div class="card-body border-top p-9">
                    <div class="row">
                        <!-- Left Section -->
                        <div class="col-xl-12">
                            <div class="row align-items-center mb-10">
                                <label class="form-label col-form-label required fw-semibold fs-6">RFQ No</label>
                                <div class="col-auto">
                                    <input type="text" class="form-control" placeholder="" oninput="this.value = this.value.toUpperCase()" id="txtRfqNO" maxlength="15" onkeypress="return AllowAlphaNumericOnly(event)" />
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-primary me-2" type="button" id="btnShowData">Show Data</button>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-6">
                            <div class="mb-4">
                                <div class="row">
                                </div>
                                <label class="form-label col-form-label fw-semibold fs-6">Customer Name</label>
                                <select class="form-select select2 form-select-solid form-select-lg fw-semibold" aria-label="Selection Box"
                                        data-control="select2" placeholder="Selection Box" id="txtCustomerName">
                                    <option value="">Select a Customer Name</option>
                                    <option value="0">Afghanistan</option>
                                    <option value="1">Aland Islands</option>
                                    <option value="2">Albania</option>
                                    <option value="3">Algeria</option>
                                </select>
                            </div>
                            <div class="row">
                                <div class="col-xl-6">
                                    <div class="mb-4">
                                        <label class="form-label col-form-label fw-semibold fs-6">RFQ Expired On</label>
                                        <input type="datetime-local" onfocus="this.min=new Date().toISOString().slice(0,16)" class="form-control" id="txtRfqExpiredOn" />
                                    </div>

                                </div>
                                <div class="col-xl-6">
                                    <div class="mb-4">
                                        <label class="form-label col-form-label fw-semibold fs-6">Vehicle Req On</label>
                                        <input type="date" onfocus="this.min=new Date().toISOString().split('T')[0]" class="form-control" id="txtVehicleReqDate" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xl-6">
                                    <div class="mb-4">
                                        <label class="form-label col-form-label fw-semibold fs-6">RFQ On</label>
                                        <select class="form-select select2 form-select-solid form-select-lg fw-semibold" aria-label="Qty/Vehicle"
                                                data-control="select2" placeholder="Qty/Vehicle" id="txtRfqOn">
                                            <option value="">Select a Option</option>
                                            <option value="0">Qty</option>
                                            <option value="1">Vehicle</option>
                                        </select>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label col-form-label  fw-semibold fs-6">Item Name</label>
                                        <select class="form-select select2 form-select-solid form-select-lg fw-semibold" aria-label="Selection Box"
                                                data-control="select2" placeholder="Selection Box" id="txtItemName">
                                            <option value="">Select a Item Name</option>
                                            <option value="0">Afghanistan</option>
                                            <option value="1">Aland Islands</option>
                                            <option value="2">Albania</option>
                                            <option value="3">Algeria</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xl-6">
                                    <div class="mb-4">
                                        <label class="form-label col-form-label fw-semibold fs-6">Vehicle Type</label>
                                        <select class="form-select select2 form-select-solid form-select-lg fw-semibold" aria-label="Vehicle Type"
                                                data-control="select2" placeholder="Vehicle type" id="txtVehicleType">
                                            <option value="">Select a Vehicle Type</option>
                                            <option value="0">Afghanistan</option>
                                            <option value="1">Aland Islands</option>
                                            <option value="2">Albania</option>
                                            <option value="3">Algeria</option>
                                        </select>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label col-form-label fw-semibold fs-6">L1 Hire Cost</label>
                                        <input type="text" class="form-control" placeholder="Text" id="txtSpecialInstructions" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Section -->

                        <div class="col-xl-6">
                            <div class="row">
                                <div class="col-xl-6">
                                    <div class="mb-4">
                                        <label class="form-label col-form-label fw-semibold fs-6">RFQ No</label>
                                        <input type="text" class="form-control form-control-solid" placeholder="Auto Generated" disabled id="txtRfqNo" />
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label col-form-label fw-semibold fs-6">Origin/From</label>
                                        <input type="text" class="form-control" id="txtOrigin" placeholder="Map Based Search" />
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label col-form-label fw-semibold fs-6">No. of Vehicles</label>
                                        <input type="text" class="form-control" id="txtNoofVehicles" placeholder="Numeric" />
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label col-form-label fw-semibold fs-6">Detention Per Day</label>
                                        <input type="text" class="form-control" placeholder="Numeric" id="txtTotalQty" />
                                    </div>
                                </div>
                                <div class="col-xl-6">
                                    <div class="mb-4">
                                        <label class="form-label col-form-label fw-semibold fs-6">RFQ Date</label>
                                        <input type="datetime-local" class="form-control" id="txtRfqDate" />
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label col-form-label fw-semibold fs-6">Destination/To</label>
                                        <input type="text" class="form-control " placeholder="Map Based Search" id="txtDestination" />
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label col-form-label fw-semibold fs-6">Totak Qty in Tons</label>
                                        <input type="text" class="form-control" placeholder="Numeric" id="txtTotalQty" />
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label col-form-label fw-semibold fs-6">Detention Free Days</label>
                                        <input type="text" class="form-control" placeholder="Numeric" id="txtTotalQty" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-3">
                            <div class="mb-4">
                                <label class="form-label col-form-label fw-semibold fs-6">Paking Type</label>
                                <input type="text" class="form-control" placeholder="Text" id="txtPakingType" />
                            </div>
                        </div>
                        <div class="col-xl-9">
                            <div class="mb-4">
                                <label class="form-label col-form-label fw-semibold fs-6">Special Instructions</label>
                                <input type="text" class="form-control" placeholder="Text" id="txtSpecial" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-3">
                            <div class="mb-4">
                                <label class="form-label required col-form-label fw-semibold fs-6">Quote Rate</label>
                                <input type="text" class="form-control" placeholder="Numeric" id="txtTotalQty" />
                            </div>
                        </div>
                        <div class="col-xl-3">
                            <div class="mb-4">
                                <label class="form-label required col-form-label fw-semibold fs-6">Detention Per Day</label>
                                <input type="text" class="form-control" placeholder="Numeric" id="txtTotalQty" />
                            </div>
                        </div>
                        <div class="col-xl-3">
                            <div class="mb-4">
                                <label class="form-label required col-form-label fw-semibold fs-6">Detention Free Days</label>
                                <input type="text" class="form-control" placeholder="Numeric" id="txtTotalQty" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-start py-6 px-9">
                    <button type="button" id="btnSave" class="btn btn-primary me-2">Save</button>
                    <button type="button" id="btnSaveAndNew" class="btn btn-primary">Save & New</button>
                </div>
            </form>
        </div>
    </div>
</div>
