<script>
    $(document).ready(function () {
        var GetUrl = '@Url.Content("~/Customer/ViewCustomer")';
        $.ajax({
            url: GetUrl,
            method: 'GET',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                $('#ddlPartyExe').empty();

                console.log(data);

                data.forEach(function (item) {
                    $('#ddlPartyExe').append('<option value="' + item.partyId + '">' + item.partyName + '</option>');
                });
                if ($.fn.selectpicker) {
                    $('#ddlPartyExe').selectpicker('refresh');
                }
                else {
                    console.error('Bootstrap Select library not loaded properly.');
                }
            },
            error: function () {
                alert('Error loading data');
            }
        });
    });
</script>