<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="~/js/common.js"></script>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.10.3/themes/smoothness/jquery-ui.css" />
<script src="https://code.jquery.com/jquery-1.9.1.js"></script>
<script src="https://code.jquery.com/ui/1.10.3/jquery-ui.js"></script>


<script>
    document.getElementById("txtPanNumber").addEventListener("input", function() {
        const panKyc = this.value.toUpperCase();
        document.getElementById("numPan").value = panKyc;
    });
     document.getElementById("txtGstNumber").addEventListener("input", function() {
        const gstKyc = this.value.toUpperCase();
        document.getElementById("numGstNumber").value = gstKyc;
    });

     $(document).ready(function ()
    {

        $(document).on("click", "#viewButton", function () {
            fetchCustomerList();
            $("#addCustomerDiv").css('display', 'none')
            $("#backButton").css('display', 'Block');
        });
        // Check Form Validation
        $("#txtGstNumber").on("change", function() {
            var GstValue = $(this).val();
            if (!/^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[A-Z0-9]{1}Z[A-Z0-9]{1}$/.test(GstValue.toUpperCase())) {
            $("#txtGstNumber").val('');
            $("#numGstNumber").val('');
            toastr.warning("Please enter a valid GST No", "Warning");
            return;
            }
            $("#numGstNumber").val(GstValue.toUpperCase());
        });
        $("#txtPanNumber").on("change", function () {
            var PanEValue = $(this).val();
            if (!/^[A-Z]{5}[0-9]{4}[A-Z]{1}$/.test(PanEValue.toUpperCase())) {
                $("#txtPanNumber").val('');
                $("#numPan").val('');
                toastr.warning("Please enter a valid PAN No", "Warning");
                return;
            }
            $("#numPan").val(PanEValue.toUpperCase());
        });
        $("#txtCustomerName").on("change",function() {
            var CustomerValue = $(this).val();
            if (!isAlphabets(CustomerValue)){
                $("#txtCustomerName").val('');
                toastr.warning("Please enter a valid Customer Name", "Warning");
                return;
            }
        });
        $("#txtCustomerCode").on("change",function() {
            var CustomerCode = $(this).val();
            if (!isAlphabets(CustomerCode)){
                $("#txtCustomerCode").val('');
                toastr.warning("Please enter a valid Customer Code", "Warning");
                return;
            }
        });
        $("#txtaddress").on("change",function() {
            var Address = $(this).val();
            if (!isAlphaNumeric(Address)){
                $("#txtaddress").val('');
                toastr.warning("Please enter a valid Address", "Warning");
                return;
            }
        });

        $("#selectCity").on("change",function() {
            var SelectCity = $(this).val();
            if (!isValidateSelect(SelectCity)){
                // $("#selectCity").val('');
                toastr.warning("Please select a City", "Warning");
                return;
            }
        });
        $("#txtContactPerson").on("change", function () {
            var contactPerson = $(this).val();
            if (!isAlphabets(contactPerson)) {
                $("#txtContactPerson").val('');
                toastr.warning("Please enter a valid Contact Person Name", "Warning");
                return;
            }
        });
        $("#numMobile").on("change", function() {
            var MobileValue = $(this).val();
            if (!isMobile(MobileValue)) {
            $("#numMobile").val('');
            toastr.warning("Please enter a valid Mobile Number", "Warning");
            return;
            }
        });
        $("#numContact").on("change", function() {
            var MobileValue = $(this).val();
            if (!isMobile(MobileValue)) {
            $("#numContact").val('');
            toastr.warning("Please enter a valid Contact No", "Warning");
            return;
            }
        });
        $("#selectPartyExecutive").on("change",function() {
            var SelectParty = $(this).val();
            if (!isValidateSelect(SelectParty)){
                // $("#selectPartyExecutive").val('');
                toastr.warning("Please select PartyExecutive", "Warning");
                return;
            }
        });
        $("#numPincode").on("change", function() {
            var PinValue = $(this).val();
            if (!/^\d{6}$/.test(PinValue)) {
            $("#numPincode").val('');
            toastr.warning("Please enter a valid Pincode", "Warning");
            return;
            }
        });
        $("#numWhatsApp").on("change", function() {
            var WhatsAppValue = $(this).val();
            if (!isMobile(WhatsAppValue)) {
            $("#numWhatsApp").val('');
            toastr.warning("Please enter a valid WhatsApp Number", "Warning");
            return;
            }
        });
        $("#txtEmail").on("change", function() {
            var EmailValue = $(this).val();
            if (!isValidateEmail(EmailValue)) {
            $("#txtEmail").val('');
            toastr.warning("Please enter a valid email", "Warning");
            return;
            }
        });


        document.querySelectorAll("#txtGstNumber, #txtPanNumber").forEach(function (element) {
            element.addEventListener("input", function () {
                this.value = this.value.toUpperCase();
            });
        });

        // On form submit
        $("#btnSaveCustomer").click(function (event) {
            event.preventDefault();
            SaveAndSaveNew();
        });

        // Reset form fields on button click
        $('#SavenewButton').on('click', function () {
            SaveAndSaveNew();
            $('#CustomerForm')[0].reset();
        });

        $('#backButton').click(function () {
            $("#addCustomerDiv").css('display', 'Block')
            $("#backButton").css('display', 'none');
             $('#tableDiv').hide();
        });
        GetAllCityList();
    });

     function fetchCustomerList() {
        $('#tableDiv').show();
        var fetchCustomerUrl = '@Url.Content("~/Customer/ViewCustomer")';
        $.ajax({
            url: fetchCustomerUrl,
            type: "GET",
            dataType: "json",
            success: function (response) {

                let trlist = response.customerViewModelDtos;
                customerViewModelDtos = response.customerViewModelDtos;
                // Destroy existing DataTable if exists
                if ($.fn.DataTable.isDataTable('#tableCustomer')) {
                    $('#tableCustomer').DataTable().clear().destroy();
                }

                $('#tableCustomer').DataTable({
                    "processing": true,
                    "serverSide": false,
                    "paging": true,
                    "pageLength": 10,
                    "lengthChange": true,
                    "searching": true,
                    "ordering": true,
                    "info": true,
                    "autoWidth": true,
                    "responsive": true,
                    "info": true,
                    "autoWidth": true,
                    "responsive": true,
                    "data": trlist,
                    "columns": [

                        { "data": "partyName" },
                        { "data": "addressLine" },
                        { "data": "pinCode" },
                        { "data": "mobNo" },
                        { "data": "email" },
                        { "data": "panNo" },
                        { "data": "gstNo" },
                        {
                            "data": "partyId",
                            "render": function (data, type, row) {
                                return `
                                               <div class="btn-group" role="group">
                                                   <button type="button" class="btn btn-sm btn-primary"
                                                       onclick="editCustomer(${data})">
                                                       <i class="ti ti-edit"></i> Edit
                                                   </button>
                                                   <button type="button" class="btn btn-sm btn-danger"
                                                       onclick="deleteCustomer(${data})">
                                                       <i class="ti ti-trash"></i> Delete
                                                   </button>
                                               </div>`;
                            }
                        },
                    ],
                    "columnDefs": [
                        {
                            "targets": "_all",
                            "className": "text-center"
                        }
                    ]
                });


            },
            error: function (xhr, status, error) {
                console.error("Error:", error);
                toastr.error("Failed to fetch data!", "Error");
            }
        });
    }

     function SaveAndSaveNew() {
        var gstKyc = $("#gstEkyc").val();
        var legalName = $("#txtLegalName").val();
        var typeBusiness = $("#txtTypeBusiness").val();
        var gstStatus = $("#txtGstStatus").val();
        var tradeName = $("#txtTradeName").val();
        var adharVerified = $("#txtAadharVerified").val();
        var gstVerifiedOn = $("#txtGstVerifiedOn").val();
        var adharLinked = $("#txtAadharLinked").val();
        var panStatus = $("#txtPanStatus").val();
        var panVerifiedOn = $("#txtPanVerifiedOn").val();
        var panKyc = $("#txtPanNumber").val();
        var customerName = $("#txtCustomerName").val();
        var customerCode = $("#txtCustomerCode").val();
        var address = $("#txtaddress").val();
        var city = $("#selectCity").val();
        var contactPerson = $("#txtContactPerson").val();
        var mobileNumber = $("#numMobile").val();
        var panNumber = $("#numPan").val();
        var partyExecutive = $("#selectPartyExecutive").val();
        var pincode = $("#numPincode").val();
        var whatsAppNumber = $("#numWhatsApp").val();
        var contactNo = $("#numContact").val();
        var email = $("#txtEmail").val();
        var gstNumber = $("#numGstNumber").val();

        if (!isAlphabets(customerName)) {
            toastr.warning("Please enter a valid Customer Name", "Warning");
            return;
        }
        if (!isAlphabets(customerCode)) {
            toastr.warning("Please enter a valid Customer Code", "Warning");
            return;
        }
        if (!isAlphaNumeric(address)) {
            toastr.warning("Please enter a valid Address", "Warning");
            return;
        }
        if (!isValidateSelect(city)){
           toastr.warning("Please select a City", "Warning");
           return;
        }
        if (!isAlphabets(contactPerson)) {
            toastr.warning("Please enter a valid Contact Person", "Warning");
            return;
        }
        if (!isMobile(mobileNumber)) {
            toastr.warning("Please enter a valid Mobile Number", "Warning");
            return;
        }
        if (!/^[A-Z]{5}[0-9]{4}[A-Z]{1}$/.test(panNumber.toUpperCase())) {
           toastr.warning("Please enter a valid PAN number", "Warning");
           return;
        }
        if (!isValidateSelect(partyExecutive)){
           toastr.warning("Please select PartyExecutive", "Warning");
           return;
        }
        if (!/^\d{6}$/.test(pincode)) {
           toastr.warning("Please enter a valid Pincode", "Warning");
           return;
        }
        if (!isMobile(whatsAppNumber)) {
            toastr.warning("Please enter a valid WhatsApp Number", "Warning");
            return;
        }
        if (!isMobile(contactNo)) {
            toastr.warning("Please enter a valid Contact No", "Warning");
            return;
        }
        if (!isValidateEmail(email)) {
           toastr.warning("Please enter a valid email", "Warning");
           return;
        }
        if (!/^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[A-Z0-9]{1}Z[A-Z0-9]{1}$/.test(gstNumber.toUpperCase())) {
           toastr.warning("Please enter a valid GST number", "Warning");
           return;
        }

        var saveUrl = '@Url.Content("~/Customer/CustomerSave")';
        var formData = {
            // GSTNo: gstKyc,
            LegalName: legalName,
            TypeOfBusiness: typeBusiness,
            GstStatus: gstStatus,
            TradeName: tradeName,
            AadharVerified: adharVerified,
            PanStatus: panStatus,
            GSTVarifiedOn: gstVerifiedOn,
            PANVerifiedOn: panVerifiedOn,
            // PANNo: panKyc,
            PartyName: customerName,
            CustomerCode: customerCode,
            AddressLine: address,
            CityId: city,
            ContactPerson: contactPerson,
            MobNo: mobileNumber,
            PANNo: panNumber,
            PartyExecutive: partyExecutive,
            Pincode: pincode,
            WhatsAppNo: whatsAppNumber,
            ContactNo: contactNo,
            Email: email,
            GSTNo: gstNumber,
            PANLinkedWithAdhar: adharLinked,

        };
        $.ajax({
            url: saveUrl,
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(formData),
            success: function (response) {
                toastr.success("Customer details submitted successfully!");

            },
            error: function (xhr, status, error) {
                console.error("Error:", error);
                toastr.error("Failed to submit Customer details", "Error");
            }
        });
    }

