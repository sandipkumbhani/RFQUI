@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Driver";
}

<div class="app-toolbar  pt-3 px-lg-3">
    <div class="app-container  container-fluid d-flex flex-stack flex-wrap">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex align-items-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-primary lh-1 fw-bolder fs-2x my-0 me-5">
                    Overview
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold">
                    <li class="breadcrumb-item text-gray-700 fw-bold lh-1">
                        <a href="#" class="text-gray-500"><i class="fa-solid fa-house"></i></a>
                    </li>
                    <li class="breadcrumb-item"><i class="fa-solid fa-chevron-right fs-4 text-gray-700 mx-n1"></i></li>
                    <li class="breadcrumb-item text-primary">
                        Driver
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="app-content px-lg-3">
    <div class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 cursor-pointer">
                <div class="card-title m-0">
                    <h3 class="fw-bold m-0">Driver</h3>
                </div>
            </div>
                      
            <form class="form" id="driverForm">
                <div class="card-body border-top p-9">
                    <div class="row">
                        <!-- Left Section -->
                        <div class="col-xl-6">
                            <div class="mb-4">
                                <label class="form-label col-form-label required fw-semibold fs-6">Driver Type</label>
                                <select class="form-select select2 form-select-solid" aria-label="Selection {Owned/Market}" id="txtDriverType"
                                        data-control="select2" placeholder="Selection {Owned/Market}">
                                    <option value="">Select a Drive Type</option>
                                    <option value="0">Owned</option>
                                    <option value="1">Market</option>
                                    <option value="2">Albania</option>
                                    <option value="3">Algeria</option>
                                </select>
                            </div>
                            <div class="mb-4">
                                <label class="form-label required fw-semibold">License No</label>
                                <input type="text" class="form-control" placeholder="License Number" id="txtLicenseNo"/>
                            </div>

                            <div class="mb-4">
                                <label class="form-label required fw-semibold">Driver Name</label>
                                <input type="text" class="form-control" placeholder="Driver Name AutoFetched" id="txtDriverName"/>
                            </div>

                            <div class="mb-4">
                                <label class="form-label required fw-semibold">DL Issue Date</label>
                                <input type="date" class="form-control" id="txtDLIssueDate"/>
                            </div>

                            <div class="mb-4">
                                <label class="form-label col-form-label fw-semibold fs-6">DL Issuing RTO</label>
                                <select class="form-select select2 form-select-solid" aria-label="Selection/Autofetched" id="txtDLIssuingRTO"
                                        data-control="select2" placeholder="Selection/Autofetched">
                                    <option value="">Select a RTO</option>
                                    <option value="0">Owned</option>
                                    <option value="1">Market</option>
                                    <option value="2">Albania</option>
                                    <option value="3">Algeria</option>
                                </select>
                            </div>
                        </div>

                        <!-- Right Section -->
                        <div class="col-xl-6">
                            <div class="mb-4" style="height:69.600px;width:540.850px;">

                            </div>
                            <div class="mb-4">
                                <label class="form-label required fw-semibold">Date of Birth</label>
                                <div class="row">
                                    <div class="col-md-8">
                                        <input type="date" class="form-control" id="txtDateOfBirth"/>
                                    </div>
                                    <div class="col-md-4">
                                        <button class="btn btn-sm btn-primary w-100">Get e-KYC</button>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-xl-6">
                                    <div class="mb-4">
                                        <label class="form-label required fw-semibold">Driver Code</label>
                                        <input type="text" class="form-control" id="txtDriverCode" placeholder="Driver Code" />
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label required fw-semibold">DL Expiry Date</label>
                                        <input type="date" class="form-control" id="txtDLExpiryDate" placeholder="AutoFetched" />
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label required fw-semibold">WhatsApp Number</label>
                                        <input type="text" class="form-control" id="txtWhatsappNumber" placeholder="WhatsApp Number" />
                                    </div>
                                </div>
                                @* <div class="col-xl-6"> *@
                                @*     <label class="form-label fw-semibold">Upload Photo</label> *@
                                @*     <input type="file" class="form-control" placeholder="Upload Photo"/> *@
                                @* </div> *@
                                <div class="col-xl-6">
                                    <div class="fv-row upload-imgs mt-10 px-5">
                                        <div class="dropzone" id="dropzonejs_1" action="https://keenthemes.com/scripts/void.php">
                                            <div class="dz-message needsclick">
                                                <i class="bi bi-cloud-upload fs-3x text-primary"></i>
                                                <div class="ms-4">
                                                    <h3 class="fs-5 fw-bold text-gray-900 mb-1">Upload Photo</h3>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="mb-4">
                                <label class="form-label col-form-label required fw-semibold fs-6">Address </label>
                                <input type="text" class="form-control" placeholder="Address" id="txtAddress" />
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mb-4">
                                <label class="form-label col-form-label required fw-semibold fs-6">City</label>
                                <select id="txtCity" name="franchise" aria-label="Select a City"
                                        data-control="select2" data-placeholder="Select a City." class="form-select select2 form-select-solid form-select-lg fw-semibold">
                                    <option value="">Select a City</option>
                                    <option value="AF">Afghanistan</option>
                                    <option value="AX">Aland Islands</option>
                                    <option value="AL">Albania</option>
                                    <option value="DZ">Algeria</option>
                                </select>
                            </div>
                            <div class="mb-4">
                                <label class="form-label col-form-label fw-semibold fs-6">Mobile Number</label>
                                <input type="text" class="form-control" placeholder="Mobile Number" id="txtMobileNumber" />
                            </div>
                            <div class="mb-4">
                                <div class="form-check form-check-custom form-check-solid mb-5">
                                    <input class="form-check-input me-0" name="checkbox_input" type="checkbox" value="" id="createlogin" />
                                    <label class="form-check-label" for="createlogin">
                                        <span class="fw-semibold text-gray-800">Create Login</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mb-4">
                                <label class="form-label col-form-label required fw-semibold fs-6">Pincode</label>
                                <input type="text" class="form-control" placeholder="Pincode" id="txtPinCode" />
                            </div>
                            <div class="mb-4">
                                <label class="form-label col-form-label fw-semibold fs-6">Verified On</label>
                                <input type="text" class="form-control form-control-solid" placeholder="fetched" />
                            </div>
                            <div class="mb-4">
                                <div class="form-check form-check-custom form-check-solid mb-5">
                                    <input class="form-check-input me-0" name="checkbox_input" type="checkbox" value="" id="shareapplink" />
                                    <label class="form-check-label" for="shareapplink">
                                        <span class="fw-semibold text-gray-800">Share App Link</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Attachment Section -->
                <div class="card-body border-top p-6">
                    <h4 class="fw-bold mb-4">Attachment Details</h4>
                    <div id="kt_docs_repeater_basic">
                        <div class="form-group">
                            <div data-repeater-list="kt_docs_repeater_basic">
                                <div data-repeater-item>
                                    <div class="form-group row">
                                        <div class="col-md-2">
                                            <label class="form-label col-form-label fw-semibold fs-6">File Name</label>
                                            <input type="email" class="form-control mb-2 mb-md-0" placeholder="File Name" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label col-form-label fw-semibold fs-6">Attachment Type  </label>
                                            <select name="franchise" aria-label="Select a Attachment Type"
                                                    data-control="select2" data-placeholder="Select a Attachment Type" class="form-select select2 form-select-solid form-select-lg fw-semibold">
                                                <option value="">Select a Attachment Type</option>
                                                <option value="AF">Afghanistan</option>
                                                <option value="AX">Aland Islands</option>
                                                <option value="AL">Albania</option>
                                                <option value="DZ">Algeria</option>
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label col-form-label fw-semibold fs-6">Choose File </label>
                                            <label class="input-group mb-3">
                                                <input class="visually-hidden" type="file">
                                                <span class="form-control">Choose File</span>
                                            </label>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label col-form-label fw-semibold fs-6">Upload  </label>
                                            <label class="input-group mb-3">
                                                <input class="visually-hidden" type="file">
                                                <span class="form-control">Upload</span>
                                            </label>
                                        </div>
                                        <div class="col-md-2 d-flex align-items-center justify-content-center">
                                            <a href="javascript:;" data-repeater-delete class="btn btn-sm btn-light-danger">
                                                <i class="bi bi-trash"></i>
                                                Delete
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group mt-5">
                            <a href="javascript:;" data-repeater-create class="btn btn-light-primary">
                                <i class="fa-solid fa-plus"></i>
                                Add
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="card-footer d-flex justify-content-start py-4">
                    <button type="button" id="btnSaveDriver" class="btn btn-primary me-2">Save</button>
                    <button type="button" id="btnsavenewDriver" class="btn btn-primary">Save & New</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="app-footer px-lg-3 ">
    <div class="app-container  container-fluid d-flex flex-column flex-md-row flex-center flex-md-stack py-3">
        <div class="text-gray-900 order-2 order-md-1">
            <span class="text-muted fw-semibold me-1">2025©</span>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="~/js/common.js"></script>
<script>
    $(document).ready(function(){

        function validateLicenseNo(number){
            return /^(([A-Z]{2}[0-9]{2})( )|([A-Z]{2}-[0-9]{2}))((19|20)[0-9][0-9])[0-9]{7}$/.test(number);
        }

        $("#btnSaveDriver").click(function(event){
            event.preventDefault();
            saveandsavenewDriver();
        })
        $("#btnsavenewDriver").click(function(event){
            saveandsavenewDriver();
            $('#driverForm')[0].reset();
        })

        $("#txtDriverType").on("change",function(){
            if(!isValidateSelect($(this).val())){
                toastr.warning("Please enter a valid Driver Type", "Warning");
                return;
            }
        });
        $("#txtDateOfBirth").on("change",function(){
            if(!isValidateSelect($(this).val())){
                toastr.warning("Please enter a valid Date Of Birth ", "Warning");
                return;
            }
        });
        $("#txtDriverCode").on("change",function(){
            if(!isAlphaNumeric($(this).val())){
                toastr.warning("Please enter a valid Driver Code ", "Warning");
                return;
            }
        }); 
        $("#txtWhatsappNumber").on("change",function(){
            if(!isMobile($(this).val())){
                toastr.warning("Please enter a valid Whatsapp Number ", "Warning");
                return;
            }
        });
        $("#txtLicenseNo").on("change",function(){
            if(!validateLicenseNo($(this).val())){
                toastr.warning("Please enter a valid License Number ", "Warning");
                return;
            }
        });
        
        function saveandsavenewDriver(){
            var driverType = $("#txtDriverType").val();
            var dateOfBirth = $("#txtDateOfBirth").val();
            var driverCode = $("#txtDriverCode").val();
            var whatsappNumber = $("#txtWhatsappNumber").val();
            var licenseNo = $("#txtLicenseNo").val();
            var driverName = $("#txtDriverName").val();
            var dlIssueDate = $("#txtDLIssueDate").val();
            var dlExpiryDate = $("#txtDLExpiryDate").val();
            var address = $("#txtAddress").val();
            var city = $("#txtCity").val();
            var pincode = $("#txtPinCode").val();

            
            if(IsNullOrEmpty(driverType)){
                toastr.warning("Please enter a valid Driver Type", "Warning");
                return false;
            }
            if(IsNullOrEmpty(dateOfBirth)){
                toastr.warning("Please enter a valid Date Of Birth ", "Warning");
                return false;
            }
            if(IsNullOrEmpty(driverCode)){
                toastr.warning("Please enter a valid Driver Code ", "Warning");
                return false;
            }
            if(IsNullOrEmpty(whatsappNumber)){
                toastr.warning("Please enter a valid Whatsapp Number ", "Warning");
                return false;
            }
            if(IsNullOrEmpty(licenseNo)){
                toastr.warning("Please enter a valid License Number ", "Warning");
                return false;
            }
            if(IsNullOrEmpty(driverName)){
               toastr.warning("Please enter a valid Driver Name  ", "Warning");
                return false;
            }
            if(IsNullOrEmpty(dlIssueDate)){
               toastr.warning("Please enter a valid Issue Date ", "Warning");
                return false;
            }
            if(IsNullOrEmpty(dlExpiryDate)){
               toastr.warning("Please enter a valid Expiry Date ", "Warning");
                return false;
            }
            if(IsNullOrEmpty(address)){
               toastr.warning("Please enter a valid Address", "Warning");
                return false;
            }
            if(IsNullOrEmpty(city)){
               toastr.warning("Please enter a valid City ", "Warning");
                return false;
            }
            if(IsNullOrEmpty(pincode)){
               toastr.warning("Please enter a valid Pin Code ", "Warning");
                return false;
            }
            return true;
        }
    })
</script>
