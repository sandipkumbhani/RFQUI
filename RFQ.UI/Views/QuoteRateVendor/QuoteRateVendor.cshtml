@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
	Layout = "_Layout";
	ViewData["Title"] = "QuoteRate-Vendor";
}
@section Scripts {
	<script src="~/js/Views/QuoteRateVendor.js"></script>
}
<head>
	<!-- Latest compiled and minified CSS -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/css/bootstrap-select.min.css">
	<!-- Latest compiled and minified JavaScript -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/js/bootstrap-select.min.js"></script>
	<!-- (Optional) Latest compiled and minified JavaScript translation files -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/js/i18n/defaults-*.min.js"></script>
	<style>
		.item-input {
			margin-bottom: 0.75rem;
		}

		.form-label span {
			color: red;
		}
	</style>
</head>


<div class="row">
	<div class="col-12">
		<div class="page-title-box add">
			<h1 class="page-title">Quote Rate - Vendor </h1>
		</div>
	</div>
	<div id="AddQuoteRoleVendorDiv" class="card com-profile-info">
		<div class="top-details">
			<form class="row all-custom-class" id="QRVendorBodyForm" method="post">
				<input type="hidden" id="rfqrateId" />
				<div class="row all-custom-class">
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">RFQ NO </label>
							<input type="text" class="form-control" placeholder="RFQ No" id="txtRFQNo" />
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">RFQ Date</label>
							<input type="datetime-local" class="form-control" placeholder="RFQ Date" id="txtRFQDate" />
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">RFQ Expire On</label>
							<input type="datetime-local" class="form-control" placeholder="Expire On" id="txtExpireOn" />
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">Vehicle Req On</label>
							<input type="datetime-local" class="form-control" placeholder="Vehicle Req On" id="txtVehicleReqOn" />
						</div>
					</div>
					<div class="col-lg-6">
						<div class="item-input">
							<label class="form-label">Vendor Name</label>
							<input type="text" class="form-control" placeholder="Vendor Name" id="txtVednorName" />
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">PAN No </label>
							<input type="text" class="form-control" placeholder="PAN No" id="txtPANNo" />
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">RFQ Priority<span>*</span></label>
							<select class="select2-custom form-control" aria-label="Selection"
									data-control="select2" placeholder="Selection" id="ddlRFQPriority">
								<option value="">Select a Priority</option>
								<option value="0">High</option>
								<option value="1">Medium</option>
							</select>
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">Origin/From</label>
							<input type="text" class="form-control" placeholder="Origin/From" id="txtOriginFrom" />
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">Destination/To</label>
							<input type="text" class="form-control" placeholder="Map Based Search" id="txtDestination" />
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">Item Name</label>
							<select class="select2-custom form-control" id="ddlItemName" style="width: 100%;">
							</select>
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">Packing Type</label>
							<select class="select2-custom form-control" id="ddlPackingType" style="width: 100%;">
							</select>
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">RFQ On</label>
							<input type="text" class="form-control" placeholder="RFQ On" id="txtRFQOn" />
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label ">Vehicle Type<span>*</span></label>
							<select class="select2-custom form-control" id="ddlVehicleType" style="width: 100%;">
							</select>
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">No.of Vehicles</label>
							<input type="text" class="form-control" placeholder="No.of Vehicles" id="txtNoOfVehicles" />
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">Total Qty in Tons</label>
							<input type="text" class="form-control" placeholder="Total Qty in Tons" id="txtTotalQTY" />
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">Total Hire Cost<span>*</span></label>
							<input type="number" class="form-control" placeholder="Total Hire Cost" id="txtHireCost" />
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">Detention Per Day <span>*</span></label>
							<input type="number" class="form-control" placeholder="Detention Per Day" id="txtDetentionDay" />
						</div>
					</div>
					<div class="col-lg-3">
						<div class="item-input">
							<label class="form-label">Detention Free Days <span>*</span></label>
							<input type="number" class="form-control" placeholder="Detention Free Days" id="txtDetentionDays" />
						</div>
					</div>
					<div class="col-lg-12">
						<div class="item-input">
							<label class="form-label">Special Instructions </label>
							<input type="text" class="form-control" placeholder="Special Instructions" id="txtInstruction" />
						</div>
					</div>
				</div>
			</form>
		</div>
		<div class="button-main">
			<a href="#" class="card-link" id="btnSaveForm" type="button" data-action="saveNew">
				<i class="ri-save-line"></i>
				<span>
					Save
				</span>
			</a>
			<a href="#" class="card-link" data-action="saveNew" id="btnSaveAndNewForm">
				<i class="ri-save-line"></i>
				<span>
					Save & New
				</span>
			</a>
			<a href="#" class="card-link" id="btnUpdate" style="display:none;">
				<i class="ri-save-line"></i>
				<span>
					Update
				</span>
			</a>
			<a href="#" class="card-link" id="btnCancel">
				<i class="ri-close-line"></i>
				<span>
					Cancel
				</span>
			</a>
		</div>
	</div>
</div>
