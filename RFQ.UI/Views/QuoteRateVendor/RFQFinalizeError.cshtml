@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    ViewData["Title"] = "QuoteRate-Vendor";
}
<style>
    .error-card {
        background-color: #f8d7da;
        border-left: 5px solid #dc3545;
        color: #842029;
    }

    .error-icon {
        font-size: 24px;
    }
</style>

<head>
    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

    <!-- Bootstrap (CDN - single source) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <link href="~/css/remixicon.css" rel="stylesheet" type="text/css" />

    <!-- Plugins -->
    <link href="~/css/intlTelInput-largeFlags.css" rel="stylesheet" type="text/css" />
    <link href="~/css/select2.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/select2-bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.1/css/bootstrap-select.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <!-- App Style -->
    <link href="~/css/app-style.css" rel="stylesheet" type="text/css" />
</head>

<div class="d-flex justify-content-center mt-4" style="position: fixed; top: 20px; left: 0; right: 0; z-index: 1050;">
    <div class="col-sm-6">
        <div class="card error-card" id="errorCard">
            <div class="card-body d-flex align-items-center">
                <div class="error-icon me-3">⚠️</div>
                <div>
                    <h5 class="card-title mb-1">Quote Already Finalized</h5>
                    <p class="card-text mb-0">
                        You cannot submit the quote rate because this quote has already been finalized.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/bootstrap.bundle.min.js"></script>
<script src="~/js/simplebar.min.js"></script>
<script src="~/js/select2.min.js"></script>
<script src="~/js/intlTelInput.min.js"></script>
<script src="~/js/jquery.repeater.min.js"></script>
<script src="~/js/script-app.js?ver=@DateTime.Now.Ticks"></script>
<script src="~/js/Views/QuoteRateVendor.js?ver=@DateTime.Now.Ticks"></script>
<script src="~/js/common.js?ver=@DateTime.Now.Ticks"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
