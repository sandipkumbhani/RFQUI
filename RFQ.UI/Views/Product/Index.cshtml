@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Product";
}
@section Scripts {
    <script src="~/js/Views/Product.js"></script>
}

<div class="app-toolbar  pt-3 px-lg-3">
    <div class="app-container  container-fluid d-flex flex-stack flex-wrap">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex align-items-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-primary lh-1 fw-bolder fs-2x my-0 me-5">
                    Overview
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold">
                    <li class="breadcrumb-item text-gray-700 fw-bold lh-1">
                        <a href="#" class="text-gray-500"><i class="fa-solid fa-house"></i></a>
                    </li>
                    <li class="breadcrumb-item"><i class="fa-solid fa-chevron-right fs-4 text-gray-700 mx-n1"></i></li>
                    <li class="breadcrumb-item text-primary">
                        Item/Product
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="app-content px-lg-3">
    <div class="app-container container-fluid">
        <div class="container my-4">
            <button id="backButton" type="button" class="btn btn-primary" style="display:none">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left-circle-fill" viewBox="0 0 16 16">
                    <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z"></path>
                </svg>
                Back
            </button>
        </div>
        <div id="addProductDiv" class="card">
            <div class="card-header border-0 cursor-pointer">
                <div class="card-title m-0">
                    <h3 class="fw-bold m-0">Product</h3>
                </div>
            </div>
            <form class="form" id="productForm" method="post">
                <div class="card-body">
                    <div class="row mb-5">
                        <div class="col-md-6">
                            <input type="hidden" id="hdnItemId" />
                            <label for="profileName" class="form-label">Product Name</label>
                            <input type="text" id="txtItemName" class="form-control" placeholder="Enter Item/Product name" maxlength="50">
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-start py-4">
                    <button type="button" id="btnSaveProduct" class="btn btn-primary me-2" data-action="save">Save</button>
                    <button type="button" id="btnSavenewProduct" class="btn btn-primary me-2" data-action="saveNew">Save & New</button>
                    <button type="button" class="btn btn-primary" id="btnViewButton">View</button>
                    <button type="button" id="btnUpdateProduct" class="btn btn-primary me-2" style="display:none">Update</button>
                    <button id="btnCancel" type="button" class="btn btn-danger d-none">Cancel</button>
                </div>
            </form>
        </div>
        <div class="my-4"></div>
        <div id="tableDiv" class="card card-flush shadow-sm rounded-2xl" style="display:none">
            <div class="card-header p-4">
                <h4 class="fw-bold m-0 text-lg">Product List</h4>
            </div>
            <div class="card-body">
                <table id="tableProduct"
                       class="table table-striped align-middle fs-6 mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Company Name</th>
                            <th>Item Name</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Dynamic rows go here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
