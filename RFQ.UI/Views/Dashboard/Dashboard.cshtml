@using RFQ.UI.Domain.ResponseDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "FleetLynk";
    IList<DashboardCardResponseDto> DashboardCards = ViewBag.DashboardCards;
}

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fleetlynk Dashboard</title>
    <link rel="stylesheet" href="~/css/DashboardStyle.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        #rfqDashboardTable th,
        #rfqDashboardTable td {
        min-width: 120px;
        max-width: 250px;
        white-space: normal; /* allow wrapping */
        word-break: break-word;
        }

        #rfqDashboardTable td {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 200px;
        }

        .tooltip-cell {
        position: relative;
        cursor: pointer;
        }

        .tooltip-cell::after {
        content: attr(data-tooltip);
        position: absolute;
        bottom: 120%;
        left: 50%;
        transform: translateX(-50%);
        background: #333;
        color: #fff;
        padding: 5px 8px;
        border-radius: 4px;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.1s ease-in-out;
        }

        .tooltip-cell:hover::after {
        opacity: 1;
        }
    </style>
</head>
<body>
    <div class="layout">
        <!-- Main Area -->
        <div class="main">
            <!-- Stat Cards -->
            <section class="cards">
                @* @if (DashboardCards != null && DashboardCards.Count > 0)
                {
                    foreach (var card in DashboardCards)
                    {
                        <div class="card" id="@card.CardId" onclick="PopUpModel('@card.CardId','@card.CardHeader.Replace("'", "\\'")')" style="cursor:pointer;">
                            <h3>@card.CardHeader</h3>
                            <p>@card.RecordCount</p>
                        </div>
                    }
                }
                else
                {
                    <div class="card">
                        <h3>No Data Available</h3>
                        <p>N/A</p>
                    </div>
                } *@

                <div class="row" style="padding:20px;">
                    @foreach (var metric in DashboardCards)
                    {
                        <div class="col-md-3 mb-4">
                            <div class="card card-animate card-hover"
                                 style="border:2px solid @metric.BorderColor; border-radius:12px; cursor:pointer; font-family: 'Inter' , sans-serif;"
                                 onclick="PopUpModel('@metric.CardId','@metric.CardHeader.Replace("'", "\\'")')">

                                <div class="card-body">

                                    <!-- Icon + Trend -->
                                    <div class="d-flex justify-content-between mb-3">
                                        <div class="icon-animate" style="background:@metric.BgColor; padding:10px; border-radius:10px;border:1px solid @metric.BorderColor;">
                                            <span class="icon-jump" style="font-size:20px;">@metric.Icon</span>
                                        </div>

                                        @if (!string.IsNullOrEmpty(metric.Trend))
                                        {
                                            <span style="font-size:12px; padding:5px 10px; border-radius:20px;
                                                background:@(metric.RecordCount > 0 ? "rgba(16,185,129,0.1)" : "rgba(239,68,68,0.1)");
                                                color:@(metric.RecordCount > 0 ? "#10B981" : "#EF4444")">
                                                @metric.Trend
                                            </span>
                                        }
                                    </div>

                                    <!-- CardHeader -->
                                    <h6 style="color:#64748B;">@metric.CardHeader</h6>

                                    <!-- Value -->
                                    <div class="d-flex justify-content-between align-items-end" s>
                                        <h2 style="color:@metric.Color;font-family:Poppins, sans-serif;font-weight:var(--font-weight-bold);">@metric.RecordCount</h2>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

            </section>
        
        </div>
    </div>


    <div class="modal fade" id="PopupModal" tabindex="-1" aria-labelledby="driverPopupModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content" style="max-width:100%;width:100%">
                <div class="modal-header">
                    <h5 class="modal-title" id="popupModalLabel"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="max-width:100%;width:100%">
                    <div id="rfqCardDetailsTableDiv"></div>
                </div>
            </div>
        </div>
    </div>
</body>


@section Scripts {
    <script src="~/js/Views/Dashboard.js?ver=@DateTime.Now.Ticks"></script>
}