@using RFQ.UI.Domain.ResponseDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "FleetLynk";
    IList<DashboardCardResponseDto> DashboardCards = ViewBag.DashboardCards;
}
@section Scripts {
    <script src="~/js/Views/Dashboard.js?ver=@DateTime.Now.Ticks"></script>
}



<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fleetlynk Dashboard</title>
    <link rel="stylesheet" href="~/css/DashboardStyle.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        #rfqDashboardTable th,
        #rfqDashboardTable td {
        min-width: 120px;
        max-width: 250px;
        white-space: normal; /* allow wrapping */
        word-break: break-word;
        }
        #rfqDashboardTable td {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 200px;
}
.tooltip-cell {
    position: relative;
    cursor:  pointer;
}

.tooltip-cell::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 120%;
    left: 50%;
    transform: translateX(-50%);
    
    background: #333;
    color: #fff;
    padding: 5px 8px;
    border-radius: 4px;
    white-space: nowrap;

    opacity: 0;
    pointer-events: none;
    transition: opacity 0.1s ease-in-out;
}

.tooltip-cell:hover::after {
    opacity: 1;
}
    </style>
</head>
<body>
    <div class="layout">
        <!-- Main Area -->
        <div class="main">
            <!-- Stat Cards -->
            <section class="cards">
                @if (DashboardCards != null && DashboardCards.Count > 0)
                {
                    foreach (var card in DashboardCards)
                    {
                        <div class="card" id="@card.CardId" onclick="PopUpModel('@card.CardId','@card.CardHeader.Replace("'", "\\'")')" style="cursor:pointer;">
                            <h3>@card.CardHeader</h3>
                            <p>@card.RecordCount</p>
                        </div>
                    }
                }
                else
                {
                    <div class="card">
                        <h3>No Data Available</h3>
                        <p>N/A</p>
                    </div>
                }
            </section>

