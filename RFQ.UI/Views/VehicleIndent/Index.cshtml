@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
	Layout = "_Layout";
	ViewData["Title"] = "Vehicle Indent";
}

@section Scripts {
	<script src="~/js/views/VehicleIndent.js"></script>
	<script src="~/js/Map.js"></script>
}

<div class="row">
	<div class="col-12">
		<div class="page-title-box add">
			<h1 class="page-title">Vehicle Indent</h1>
		</div>

		<div id="addReqBranchDiv" class="card com-profile-info">
			<div class="top-details">
				<form class="row all-custom-class" id="vehicleIndentForm" method="post">
					<input type="hidden" id="txtVehicleIndentId" />
					<div class="row all-custom-class">
						<div class="col-lg-3">
							<div class="item-input">
								<label class="form-label">Location <span>*</span></label>
								<select class="select2-custom form-control" id="ddlLocation" style="width: 100%;">
								</select>
							</div>
						</div>
						<div class="col-lg-3">
							<div class="item-input">
								<label class="form-label">Indent No</label>
								<input type="text" class="form-control " placeholder="Auto Generated" disabled id="txtIndentNo" maxlength="50"/>
							</div>
						</div>
						<div class="col-lg-3">
							<div class="item-input">
								<label class="form-label">Indent Date</label>
                                <input type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control" aria-label="Indent Date" placeholder="Date Selection" id="txtIndentDate" />
							</div>
						</div>
						<div class="col-lg-3">
							<div class="item-input">
								<label class="form-label ">Vehicle Req On</label>
								<input type="date" onfocus="this.min=new Date().toISOString().split('T')[0]" class="form-control" id="txtVehicleReqDate" />
							</div>
						</div>
						<div class="col-lg-6">
							<div class="item-input">
								<label class="form-label">Customer Name</label>
								<select class="select2-custom form-control" data-control="select2" id="ddlCustomerName" style="width: 100%;">
								</select>
							</div>
						</div>
						@* <div class="col-lg-3">
							<div class="item-input">
								<label class="form-label ">Origin/From</label>
								<select class="select2-custom form-control" data-control="select2" id="ddlOrigin" style="width: 100%;">
								</select>
							</div>
						</div> *@
						<div class="col-lg-3">
							<div class="item-input">
								<label class="form-label" style="font-size: 14px;">* Origin/From</label>
								<div style="display: flex; align-items: center; gap: 6px;">
									<!-- Dropdown with same classes as customer name -->
									<select class="select2-custom form-control" data-control="select2" id="ddlOrigin" style="flex: 1;">
										<!-- options go here -->
									</select>
									<!-- Map Icon -->
									<a href="#" onclick="openMapPopup()" title="Open Map" style="flex-shrink: 0;">
										<img src="https://cdn-icons-png.flaticon.com/512/684/684908.png"
											 alt="Map Pin"
											 style="width: 20px; height: 20px;">
									</a>
								</div>
							</div>
						</div>
						<div id="mapModal" class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog">
							<div class="modal-dialog modal-xl" role="document">
								<div class="modal-content" id="mapModalContent" style="width: 100%;max-width: 80%;">
									<!-- _MapPartial will load here -->
								</div>
							</div>
						</div>
						<div class="col-lg-3">
							<div class="item-input">
								<label class="form-label" style="font-size: 14px;">* Destination/To</label>
								<div style="display: flex; align-items: center; gap: 6px;">
									<!-- Dropdown -->
									<select class="select2-custom form-control" data-control="select2" id="ddlDestination" style="flex: 1;">
										<!-- options go here -->
									</select>
									<!-- Map Icon -->
									<a href="#" onclick="openMapPopup('destination')" title="Open Map" style="flex-shrink: 0;">
										<img src="https://cdn-icons-png.flaticon.com/512/684/684908.png"
											 alt="Map Pin"
											 style="width: 20px; height: 20px;">
									</a>
								</div>
							</div>
						</div>

						<div class="col-lg-3">
							<div class="item-input">
								<label class="form-label">Vehicle Type</label>
								<select class="select2-custom form-control" data-control="select2" id="ddlVehicleType" style="width: 100%;">
								</select>
							</div>
						</div>
						<div class="col-lg-3">
							<div class="item-input">
								<label class="form-label">No. of Vehicles Req</label>
								<input type="text" class="form-control" id="txtNoofVehicles" placeholder="Numeric"onkeypress="return isNumber(event)" />
							</div>
						</div>
						<div class="col-lg-3">
							<div class="item-input">
								<label class="form-label ">Indent Expired On</label>
								<input type="datetime-local" onfocus="this.min=new Date().toISOString().slice(0,16)" class="form-control" id="txtRfqExpiredOn" />
							</div>
						</div>
					</div>
					<hr />
					<div class="Additional Details">
						<h3 class="page-form-title">Additional Details</h3>
						<div class="row all-custom-class">
							<div class="col-lg-6">
								<div class="item-input">
									<label class="form-label">Consignor</label>
									<input type="text" class="form-control" placeholder="Text" id="txtConsignor" maxlength="100"/>
								</div>
							</div>
							<div class="col-lg-6">
								<div class="item-input">
									<label class="form-label">Pickup Address</label>
									<input type="text" class="form-control" placeholder="Text" id="txtPickupAddress" maxlength="300"/>
								</div>
							</div>
							<div class="col-lg-6">
								<div class="item-input">
									<label class="form-label">Consignee</label>
									<input type="text" class="form-control" placeholder="Text" id="txtConsignee" maxlength="100"/>
								</div>
							</div>
							<div class="col-lg-6">
								<div class="item-input">
									<label class="form-label">Delivery Address</label>
									<input type="text" class="form-control" placeholder="Text" id="txtDeliveryAddress" maxlength="300"/>
								</div>
							</div>
							<div class="col-lg-3">
								<div class="item-input">
									<div class="item-input">
										<label class="form-label">Item Name</label>
										<select class="select2-custom form-control" id="ddlItemName" style="width: 100%;">
										</select>
									</div>
								</div>
							</div>
							<div class="col-lg-3">
								<div class="item-input">
									<label class="form-label ">Packing Type</label>
									<select class="select2-custom form-control" id="ddlPackingType" style="width: 100%;">
									</select>
								</div>
							</div>
							<div class="col-lg-6">
								<div class="item-input">
									<label class="form-label"> Remarks</label>
									<input type="text" class="form-control" placeholder="Text" id="txtRemarks" maxlength="200"/>
								</div>
							</div>
						</div>
					</div>
					<div class="button-main">
						<a href="#" class="card-link" id="btnSave" type="button" data-action="save">
							<i class="ri-save-line"></i>
							<span>
								Save
							</span>
						</a>
						<a href="#" class="card-link" id="btnsaveandnew" data-action="saveNew">
							<i class="ri-save-line"></i>
							<span>
								Save & New
							</span>
						</a>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
