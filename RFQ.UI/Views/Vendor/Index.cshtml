                                <label class="form-label col-form-label required fw-semibold fs-6">Legal Name</label>
                                <input type="text" class="form-control form-control-solid" placeholder="Legal Name" id="txtLegalName" disabled />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Type of Business</label>
