                    <div class="card-title m-0 pb-10">
                        <h3 class="fw-bold m-0">GST e-KYC Details</h3>
                    </div>
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="row align-items-center mb-10">
                                <label class="form-label col-form-label required fw-semibold fs-6" >GST No</label>
                                <div class="col-auto">
                                    <input oninput="this.value = this.value.toUpperCase()" type="text" class="form-control" id="txtGstNumber" maxlength="15" />
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-primary me-2" type="button" id="gstEKycButton">e-KYC</button>
                                </div>
                            </div>
                        </div>
