                    </div>
                </div>
                @await Html.PartialAsync("~/Views/Partials/_AttachmentDetails.cshtml")
                <div class="card-footer d-flex justify-content-srtat py-6 px-9">
                    <button type="button" id="btnSaveVendor" class="btn btn-primary me-2"data-action="save">Save</button>
                    <button type="button" id="btnSavenewVendor" class="btn btn-primary me-2" data-action="saveNew">Save & New</button>
                    <button type="button" id="btnUpdateVendor" class="btn btn-primary me-2" style="display:none;">Update</button>
