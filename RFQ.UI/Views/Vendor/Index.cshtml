@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Vendor";
}
@section Scripts {
    <script src="~/js/AttachmentDetails.js"></script>
    <script src="~/js/Views/Vendor.js"></script>
}

<div class="app-toolbar  pt-3 px-lg-3">
    <div class="app-container  container-fluid d-flex flex-stack flex-wrap">
            <div class="page-title d-flex align-items-center gap-1 me-3">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
                <h1 class="page-heading d-flex flex-column justify-content-center text-primary lh-1 fw-bolder fs-2x my-0 me-5">
                    Overview
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold">
                    <li class="breadcrumb-item text-gray-700 fw-bold lh-1">
                        <a href="#" class="text-gray-500"><i class="fa-solid fa-house"></i></a>
                    </li>
                    <li class="breadcrumb-item"><i class="fa-solid fa-chevron-right fs-4 text-gray-700 mx-n1"></i></li>
                    <li class="breadcrumb-item text-primary">
                        Vendor
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="app-content  px-lg-3">
    <div class="app-container  container-fluid">
        <div class="container my-4">
            <button id="backButton" type="button" class="btn btn-primary" style="display:none">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left-circle-fill" viewBox="0 0 16 16">
                    <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z"></path>
                </svg>
                Back
            </button>
        </div>
        <div id="addVendorDiv" class="card">
            <div class="card-header border-0 cursor-pointer">
                <div class="card-title m-0">
                    <h3 class="fw-bold m-0">Vendor</h3>
                </div>
            </div>
            <form class="form" id="vendorForm">
                <input type="hidden" id="hdnPartyId" />
                <div class="card-body border-top p-9">
                    <div class="card-title m-0 pb-10">
                        <h3 class="fw-bold m-0">GST e-KYC Details</h3>
                    </div>
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="row align-items-center mb-10">
                                <label class="form-label col-form-label required fw-semibold fs-6" >GST No</label>
                                <div class="col-auto">
                                    <input oninput="this.value = this.value.toUpperCase()" type="text" class="form-control" id="txtGstNumber" maxlength="15" onkeypress="return AllowAlphaNumericOnly(event)" />
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-primary me-2" type="button" id="gstEKycButton">e-KYC</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Legal Name</label>
                                <input type="text" class="form-control form-control-solid" placeholder="Legal Name" id="txtLegalName" disabled />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Type of Business</label>
                                <input type="text" class="form-control form-control-solid" placeholder="Type of Business" id="txtTypeBusiness" disabled />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">GST Status</label>
                                <input type="text" class="form-control form-control-solid" placeholder="GST Status" id="txtGstStatus" disabled />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">GST Address</label>
                                <input type="text" class="form-control form-control-solid" placeholder="GST Address" id="txtGstAddress" disabled />
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Trade Name</label>
                                <input type="text" class="form-control form-control-solid" placeholder="Trade Name" id="txtTradeName" disabled />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Aadhar Verified</label>
                                <input type="text" class="form-control form-control-solid" placeholder="Aadhar Verified" id="txtAadharVerified" disabled />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">GST Verified On</label>
                                <input type="date" class="form-control form-control-solid" placeholder="GST Verified On" id="txtGstVerifiedOn" disabled />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label fw-semibold fs-6">Verified GST No</label>
                                <input type="text" class="form-control form-control-solid" placeholder="Verified GST No" id="txtVerifiedGstNo" disabled />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body border-top p-9">
                    <div class="card-title m-0 pb-10">
                        <h3 class="fw-bold m-0">PAN e-KYC Details</h3>
                    </div>

                    <div class="row">
                        <div class="col-xl-12">
                            <div class="row align-items-center mb-10">
                                <label class="form-label col-form-label required fw-semibold fs-6">PAN No</label>
                                <div class="col-auto">
                                    <input oninput="this.value = this.value.toUpperCase()" type="text" class="form-control" id="txtPanNumber" maxlength="10" onkeypress="return AllowAlphaNumericOnly(event)" />
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-primary me-2" type="button" id="panEKycButton">e-KYC</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Name as per PAN </label>
                                <input type="text" class="form-control form-control-solid" id="txtPanName" placeholder="Name as per PAN" disabled />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Aadhar Linked </label>
                                <input type="text" class="form-control form-control-solid" placeholder="Aadhar Linked" id="txtAadharLinked" disabled />
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">PAN Status</label>
                                <input type="text" class="form-control form-control-solid" placeholder="PAN Status" id="txtPanStatus" disabled />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">PAN Verified On </label>
                                <input type="text" class="form-control form-control-solid" placeholder="PAN Verified On" id="txtPanVerifiedOn" disabled />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Vendor Name</label>
                                <input type="text" class="form-control" placeholder="Vendor Name" id="txtVendorName" maxlength="150" onkeypress="return isAlphabets(event)" />
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Vendor Category </label>
                                <select name="vendor" aria-label="Select a Vendor Category" id="ddlVendorCategory" class="selectpicker" data-width="100%">
                                </select>
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Address </label>
                                <input type="text" class="form-control" placeholder="Address" id="txtAddress" maxlength="200"/>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">City </label>
                                <select id="ddlCity" name="vendor" aria-label="Select a City" class="selectpicker" data-live-search="true" data-width="100%">
                                </select>
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Contact Person </label>
                                <input type="text" class="form-control" placeholder="Contact Person" id="txtContactPerson" maxlength="50" onkeypress="return isAlphabets(event)" />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Mobile Number </label>
                                <input type="text" class="form-control" placeholder="Mobile Number" id="txtMobileNumber" maxlength="10" onkeypress="return isNumber(event)" />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">PAN Number </label>
                                <input type="text" class="form-control" placeholder="PAN Number" id="numPanNumber" disabled/>
                            </div>
                            <div class="mb-5">
                                <div class="form-check form-check-custom form-check-solid mb-5">
                                    <input class="form-check-input me-0" name="checkbox_input" type="checkbox" value="" id="chkCreateUser" />

                                    <label class="form-check-label" for="createuser">
                                        <span class="fw-semibold text-gray-800">Create User</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Pincode</label>
                                <input type="text" class="form-control" placeholder="Pincode" id="txtPinCode" onkeypress="return isNumber(event)" maxlength="6"/>
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">
                                    WhatsApp Number
                                    <span>{it will be use User ID}</span>
                                </label>
                                <input type="text" class="form-control" placeholder="WhatsApp Number" id="txtWhatsappNumber" onkeypress="return isNumber(event)" maxlength="10"/>
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Email ID </label>
                                <input type="email" class="form-control" placeholder="Email ID" id="txtEmailId" maxlength="50"/>
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">GST Number </label>
                                <input type="text" class="form-control" placeholder="GST Number" id="numGstNumber" disabled/>
                            </div>
                            <div class="mb-5">
                                <div class="form-check form-check-custom form-check-solid mb-5">
                                    <input class="form-check-input me-0" name="checkbox_input" type="checkbox" value="" id="chkShareAppLink" />

                                    <label class="form-check-label" for="shareapplink">
                                        <span class="fw-semibold text-gray-800">Share App Link</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="card-header border cursor-pointer d-none">
                    <div class="card-title m-0">
                        <h3 class="fw-bold m-0">Vendor Route Details</h3>
                    </div>
                </div>
                <div class="card-body border-top p-9 d-none">
                    <div class="vtd-card">
                        <div class="card-title m-0 pb-10">
                            <h3 class="fw-bold m-0">Vehicle Types Details</h3>
                        </div>

                        <table id="datatable_vtd" class="table table-striped align-middle border rounded fs-6 gy-5 gs-7 dataTable" style="width:100%">
                            <thead>
                                <tr class="fw-semibold fs-6 text-gray-800">
                                    <th>Sr. No.</th>
                                    <th>Vehicle Type</th>
                                    <th>Edit / Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Tiger Nixon</td>
                                    <td>System Architect</td>
                                    <td class="text-end">
                                        <a href="#" class="btn btn-light btn-active-light-primary btn-sm" type="button" data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false">
                                            Actions
