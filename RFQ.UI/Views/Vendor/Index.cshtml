@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Vendor";
}
@section Scripts {
    <script src="~/js/AttachmentDetails.js"></script>
    <script src="~/js/Views/Vendor.js"></script>
}

<div id="tableDiv">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box add">
                <h1 class="page-title">Vendor</h1>

                <div class="add-btn">
                    <a href="#" id="addVendor">
                        <i class="ri-add-line"></i> <span>Add Vendor</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card com-profile-info">
                <!-- Top Header -->
                <div class="table-top-header">
                    <h4>List of Customer</h4>
                    <div class="d-flex gap-2">
                        <div class="table-search-box">
                            <input type="text" id="customVendorSearch" class="form-control form-control-sm" placeholder="Search...">
                            <button type="submit"><i class="ri-search-line"></i></button>
                        </div>
                        <div class="dropdown">
                            <button class="btn-btn-outline-secondary dropdown-toggle" type="button" id="filterDropdownCorporate" data-bs-toggle="dropdown" aria-expanded="false">
                                Filter <i class="ri-sound-module-line"></i>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="filterDropdownCorporate">
                                <li><a class="dropdown-item filter-option" data-value="">All Status</a></li>
                                <li><a class="dropdown-item filter-option" data-value="Pending">Pending</a></li>
                                <li><a class="dropdown-item filter-option" data-value="Done">Done</a></li>
                            </ul>
                        </div>
                        <div id="exportVendorButtons" class="btn-group" role="group"></div>
                    </div>
                </div>
                <!-- Table -->
                <div class="table-responsive">
                    <table id="vendorTable" class="table dt-responsive nowrap w-100">
                        <thead>
                            <tr>
                                <th>Vendor Name</th>
                                <th>Address</th>
                                <th>PinCode</th>
                                <th>ContactPerson</th>
                                <th>Mobile No</th>
                                <th>WhatsApp No</th>
                                <th>Email</th>
                                <th>PAN No</th>
                                <th>GST No</th>
                                <th class="no-sort">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody> <!-- This will be dynamically filled -->
                    </table>
                </div>
                <!-- Bottom Area -->
                <div class="datatable-footer-bottom">
                    <div class="totle-left">
                        <span id="totalList">Total List: 3</span>
                    </div>
                    <div id="customVendorPagination" class="dataTables_paginate paging_simple_numbers"></div>
                    <div class="show-page">
                        <span>Show per page:</span>
                        <select id="customVendorPagination" class="form-select">
                            <option value="5">5 </option>
                            <option value="10" selected>10 </option>
                            <option value="25">25</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="formDiv" style="display:none;">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box add">
                <h1 class="page-title">Vendor</h1>

                <div class="add-breadcrumb">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="#" id="tableDivLink">Vendor</a></li>
                            <li class="breadcrumb-item active" aria-current="page"> Add Vendor</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card com-franchise-info">
                <form id="vendorForm" method="post" class="">
                    <input type="hidden" id="hdnPartyId" />
                    <div class="franchise-details">
                        <h2 class="page-form-title">GST e-KYC Details</h2>
                        <div class="row all-custom-class">
                            <div class="col-xl-4 col-lg-6 col-md-6">
                                <div class="item-input">
                                    <div class="item-input">
                                        <label class="form-label">GST No <span>*</span></label>
                                        <div class="kyc-input">
                                            <input oninput="this.value = this.value.toUpperCase()" type="text" class="form-control" id="txtGstNumber" maxlength="15" placeholder="Enter GST No" onkeypress="return AllowAlphaNumericOnly(event)" />
                                            <button class="kyc-btn" type="button" id="gstEKycButton">e-KYC</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-8 col-lg-6 col-md-6">
                                <div class="item-input">
                                    <label class="form-label">Legal Name <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Enter Legal Name" id="txtLegalName" disabled />
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <div class="item-input">
                                    <label class="form-label">Type of Business <span>*</span></label>
                                    <input type="text" class="form-control " placeholder="Type of Business" id="txtTypeBusiness" disabled />
                                </div>
                            </div>
                            <div class="col-lg-8">
                                <div class="item-input">
                                    <label class="form-label">Trade Name <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Enter Trade Name" id="txtTradeName" disabled />
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="item-input">
                                    <label class="form-label">Aadhar Verified <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Aadhar Verified" id="txtAadharVerified" disabled />
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="item-input">
                                    <label class="form-label">Verified GST No <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Verified GST No" id="txtVerifiedGstNo" disabled />
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="item-input">
                                    <label class="form-label">GST Verified On <span>*</span></label>
                                    <input type="date" class="form-control" placeholder="GST Verified On" id="txtGstVerifiedOn" disabled />
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="item-input">
                                    <label class="form-label">GST Status <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="GST Status" id="txtGstStatus" disabled />
                                </div>
                            </div>
                            <div class="col-lg-8">
                                <div class="item-input">
                                    <label class="form-label">GST Address <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="GST Address" id="txtGstAddress" disabled />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="franchise-owner-details">
                        <h2 class="page-form-title">PAN e-KYC Details</h2>
                        <div class="row all-custom-class">
                            <div class="col-xl-4 col-lg-6 col-md-6">
                                <div class="item-input">
                                    <div class="item-input">
                                        <label class="form-label">PAN No <span>*</span></label>
                                        <div class="kyc-input">
                                            <input oninput="this.value = this.value.toUpperCase()" type="text" class="form-control" id="txtPanNumber" maxlength="10" placeholder="Enter PAN No" onkeypress="return AllowAlphaNumericOnly(event)" />
                                            <button class="kyc-btn" type="button" id="panEKycButton">e-KYC</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-8 col-lg-6 col-md-6">
                                <div class="item-input">
                                    <label class="form-label">Name as per PAN <span>*</span></label>
                                    <input type="text" class="form-control " id="txtPanName" placeholder="Name as per PAN" disabled />
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="item-input">
                                    <label class="form-label">Aadhar Linked <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Aadhar Linked" id="txtAadharLinked" disabled />
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="item-input">
                                    <label class="form-label">PAN Verified On <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="PAN Verified On" id="txtPanVerifiedOn" disabled />

                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="item-input">
                                    <label class="form-label">PAN Status <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="PAN Status" id="txtPanStatus" disabled />
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">Vendor Name <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Vendor Name" id="txtVendorName" maxlength="150" onkeypress="return isAlphabets(event)" />
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">Vendor Category <span>*</span></label>
                                    <select class="select2-custom form-control" aria-label="Select a Vendor Category" id="ddlVendorCategory" style="width: 100%;">
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="item-input">
                                    <label class="form-label">Address <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Address" id="txtAddress" maxlength="200" />
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">City <span>*</span></label>
                                    <select class="select2-custom form-control" id="ddlCity" name="vendor" aria-label="Select a City" data-live-search="true" style="width: 100%;">
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">Pincode <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Pincode" id="txtPinCode" onkeypress="return isNumber(event)" maxlength="6" />
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">Contact Person <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Enter Contact Person" id="txtContactPerson" maxlength="50" onkeypress="return isAlphabets(event)" />
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">Email <span>*</span></label>
                                    <input type="email" class="form-control" placeholder=" Enter Email ID" id="txtEmailId" maxlength="50" />
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">Mobile Number <span>*</span></label>
                                    <input type="text" class="form-control phone-input" placeholder="+1 (555) 000-0000" id="txtMobileNumber" maxlength="10" onkeypress="return isNumber(event)" />
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">WhatsApp Number <span>*</span></label>
                                    <input type="text" class="form-control phone-input" placeholder="+1 (555) 000-0000" id="txtWhatsappNumber" onkeypress="return isNumber(event)" maxlength="10" />
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">Pan Number <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="xxxxxxxxxx" id="numPanNumber" disabled />
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">GST Number <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="xxxxx-xxxxx-xxxxx" id="numGstNumber" disabled />
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <ul class="profile-check-box">
                                        <li>
                                            <label class="check-box-custom">
                                                <input class="form-check-input" type="checkbox" value="" name="user_view">
                                                <span class="checkmark"></span>
                                                <span class="form-check-label">
                                                    Create User
                                                </span>
                                            </label>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <ul class="profile-check-box">
                                        <li>
                                            <label class="check-box-custom">
                                                <input class="form-check-input" type="checkbox" value="" name="user_view">
                                                <span class="checkmark"></span>
                                                <span class="form-check-label">
                                                    Share App Link
                                                </span>
                                            </label>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    @await Html.PartialAsync("~/Views/Partials/_AttachmentDetails.cshtml")

                    <div class="button-main">
                        <a href="#" class="card-link" id="btnSaveVendor" type="button" data-action="save">
                            <i class="ri-save-line"></i>
                            <span>
                                Save
                            </span>

                        </a>

                        <a href="#" class="card-link" id="btnsaveandnew" data-action="saveNew">
                            <i class="ri-save-line"></i>
                            <span>
                                Save & New
                            </span>
                        </a>
                        <a href="#" class="card-link" id="btnupdate" style="display:none;">
                            <i class="ri-save-line"></i>
                            <span>
                                Update
                            </span>
                        </a>
                        <a href="#" class="card-link" id="btnCancel">
                            <i class="ri-close-line"></i>
                            <span>
                                Cancel
                            </span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
