@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "RECEIVED COSTING";
}
@section Scripts {
    <script src="~/js/views/ReceivedVendorCosting.js"></script>
}

<div class="tab-pane fade show active" id="costingReceived" role="tabpanel" aria-labelledby="costingReceived-tab">
    <div class="card com-profile-info">
        <!-- Top Header -->
        <div class="table-top-header">
            <h4>Costing Received from Vendor</h4>
        </div>

        <div class="table-responsive">
            <table id="costingReceivedTable" class="table dt-responsive nowrap w-100">
                <thead>
                    <tr class="text-center">
                        <th>Sr. No.</th>
                        <th>Indent No</th>
                        <th>Indent Date</th>
                        <th>RFQ No</th>
                        <th>RFQ Date</th>
                        <th>Customer Name</th>
                        <th>RFQ Expired On</th>
                        <th>Vehicle Req On</th>
                        <th>Origin</th>
                        <th>Destination</th>
                        <th>Vehicle Type</th>
                        <th>Available Vehicle</th>
                        <th>Vendor Name</th>
                        <th>Total Hire Cost</th>
                        <th>Vendor Position</th>
                        <th>View Quote Rate</th>
                        <th>Ask for Re-Bid</th>
                    </tr>
                </thead>
                <tbody id="costingReceivedTableBody" class="text-center">
                </tbody>
            </table>
        </div>
        <!-- Bottom Area -->
        <div class="datatable-footer-bottom">
            <div class="totle-left">
                <span id="totalList">Total List: 3</span>
            </div>
            <div id="customPagination" class="dataTables_paginate paging_simple_numbers"></div>
            <input type="hidden" id="currentPage" value="1">
            <div class="show-page">
                <span>Show per page:</span>
                <select id="pageLength" class="form-select">
                    <option value="5">5 </option>
                    <option value="10" selected>10 </option>
                    <option value="25">25</option>
                </select>
            </div>
        </div>

        <div class="button-main">
            <a href="#" class="card-link me-3" id="btnSave" data-action="save">
                <i class="ri-save-line"></i>
                <span>Save</span>
            </a>
            <a href="#" class="card-link" id="btnSaveAndNew" data-action="saveNew">
                <i class="ri-save-line"></i>
                <span>Save & New</span>
            </a>
        </div>
    </div>
</div>

<div class="modal fade" id="quoteVendorModal" tabindex="-1" aria-labelledby="quoteVendorModalLabel" aria-hidden="true">
    <div class="modal-dialog" style="max-width:1000Px;width:100%;">
        <div class="modal-content" style="max-width:1000Px;width:100%;">
            <div class="modal-header">
                <h5 class="modal-title" id="driverPopupModalLabel">Quatation Rate</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- Your modal body -->
            <div class="modal-body">
                <form class="row all-custom-class" id="QRVendorBodyForm" method="post">
                    <input type="hidden" id="rfqrateId" />
                    <div class="row all-custom-class">
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label">RFQ NO </label>
                                <input disabled type="text" class="form-control" placeholder="RFQ No" id="txtRFQNo" />
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label">RFQ Date</label>
                                <input disabled type="text" class="form-control" placeholder="RFQ Date" id="txtRFQDate" />
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label">RFQ Expire On</label>
                                <input disabled type="text" class="form-control" placeholder="Expire On" id="txtExpireOn" />
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label">Vehicle Req On</label>
                                <input disabled type="text" class="form-control" placeholder="Vehicle Req On" id="txtVehicleReqOn" />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="item-input">
                                <label class="form-label">Vendor Name</label>
                                <input disabled class="form-control" placeholder="Vendor Name" id="txtVednorName" style="width: 100%;">
                                <input type="hidden" id="RfqId" name="RfqId">
                                <input type="hidden" id="vendorId" name="vendorId">
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label">PAN No </label>
                                <input disabled type="text" class="form-control" placeholder="PAN No" id="txtPANNo" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label ">Origin/From</label>
                                <input disabled class="form-control" id="ddlOrigin" style="width: 100%;">
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label">Destination/To</label>
                                <input disabled class="form-control" id="ddlDestination" style="width: 100%;">
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label ">Vehicle Type</label>
                                <input disabled class="form-control" id="ddlVehicleType" style="width: 100%;">
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label">No.of Vehicles Req</label>
                                <input disabled type="text" class="form-control" placeholder="No.of Vehicles" id="txtNoOfVehicles" />
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label">Item Name</label>
                                <input disabled class="form-control" id="ddlItemName" style="width: 100%;">
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label">Packing Type</label>
                                <input disabled class="form-control" id="ddlPackingType" style="width: 100%;">
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="item-input">
                                <label class="form-label">Special Instructions </label>
                                <input disabled type="text" class="form-control" placeholder="Special Instructions" id="txtInstruction" />
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label"><span>*</span>Available Vehicle Count</label>
                                <input type="text" class="form-control" placeholder="Available Vehicle Count" id="txtAvailableVehicle" onkeypress="return isNumber(event)" />
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label"><span>*</span>Total Hire Cost</label>
                                <input type="text" class="form-control" placeholder="Total Hire Cost" id="txtHireCost" onkeypress="return isNumber(event)" />
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label"><span>*</span>Detention Per Day</label>
                                <input type="text" class="form-control" placeholder="Detention Per Day" id="txtDetentionDay" onkeypress="return isNumber(event)" />
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="item-input">
                                <label class="form-label"><span>*</span>Detention Free Days</label>
                                <input type="text" class="form-control" placeholder="Detention Free Days" id="txtDetentionFreeDays" onkeypress="return isNumber(event)" />
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

