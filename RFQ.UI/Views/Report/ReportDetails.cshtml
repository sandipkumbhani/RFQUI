@{
    Layout = "_Layout";
    string ReportName = ViewBag.ReportName;
    ViewData["Title"] = ReportName;
    int LinkId = ViewBag.LinkId;
}
<link href="~/css/reportstyle.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
<input type="hidden" id="LinkId" value="@LinkId" />
<br />
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row align-items-end g-3">

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label">Location</label>
                        <select class="select2-custom form-control" id="ddlLocation" style="width: 100%;">
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label">From Date</label>
                        <input type="date" id="fromDate" class="form-control" />
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label">To Date</label>
                        <input type="date" id="toDate" class="form-control" />
                    </div>

                    <div class="col-lg-3 col-md-6 d-flex gap-2">
                        <button id="btnSearch" class="btn btn-outline-primary w-100">
                            <i class="fa fa-search me-1"></i> Search
                        </button>

                        <button id="btnReset" class="btn btn-outline-danger w-100">
                            <i class="bi bi-arrow-clockwise me-1"></i> Reset
                        </button>
                    </div>
                </div>
                <br>
            </div>
        </div>
    </div>
</div>
<div id="rfqCardDetailsTableDiv" class="d-none">
    <div class="pt-4">
        <!-- Header Card -->
        <div class="card shadow-sm mb-4 header-card">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-lg-6 mb-3 mb-lg-0">
                        <h1 class="h3 mb-2 text-dark" id="reportTitle">Loading Report...</h1>
                        <p class="text-muted small mb-0" id="recordsInfo">
                            Please wait...
                        </p>
                    </div>
                    <div class="col-lg-6">
                        <div class="row g-3 justify-content-lg-end">
                            <!-- Records per page -->
                            <div class="col-auto">
                                <div class="d-flex align-items-center">
                                    <label for="recordsPerPage" class="form-label me-2 mb-0 text-nowrap small">Show:</label>
                                    <select id="recordsPerPage" class="form-select form-select-sm" style="width: auto;">
                                        <option value="10">10</option>
                                        <option value="25">25</option>
                                        <option value="50">50</option>
                                        <option value="100">100</option>
                                    </select>
                                </div>
                            </div>
                            <!-- Export Button -->
                            <div class="col-auto">
                                <button id="exportExcel" class="btn btn-success btn-sm" disabled>
                                    <i class="bi bi-file-earmark-excel me-2"></i>Export Excel
                                </button>
                                <button id="exportPDF" class="btn btn-danger btn-sm" disabled>
                                    <i class="bi bi-file-pdf me-2"></i>Export PDF
                                </button>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Search Bar -->
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="position-relative">
                            <i class="fas fa-search search-icon"></i>
                            <input type="text"
                                   id="searchInput"
                                   class="form-control search-input"
                                   placeholder="Search across all columns..."
                                   disabled>
                            <button id="clearSearch" class="btn-clear-search" style="display: none;">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Card -->
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <!-- Loading State -->
                <div id="loadingState" class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted">Loading report data...</p>
                </div>

                <!-- Error State -->
                <div id="errorState" class="text-center py-5" style="display: none;">
                    <i class="fas fa-exclamation-triangle fa-4x text-danger mb-3"></i>
                    <h5 class="mb-2 text-danger">Error Loading Report</h5>
                    <p class="text-muted" id="errorMessage">Failed to load report data. Please try again.</p>
                    <button id="retryBtn" class="btn btn-primary mt-3">
                        <i class="fas fa-redo me-2"></i>Retry
                    </button>
                </div>

                <!-- Empty State -->
                <div id="emptyState" class="text-center py-5" style="display: none;">
                    <i class="fas fa-file-excel fa-4x text-muted mb-3"></i>
                    <h5 class="mb-2">No data found</h5>
                    <p class="text-muted" id="emptyMessage">No data available to display</p>
                    <button id="clearSearchBtn" class="btn btn-primary mt-3" style="display: none;">
                        Clear Search
                    </button>
                </div>

                <!-- Table Container -->
                <div id="tableContainer" style="display: none;">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="reportTable">
                            <thead class="table-light">
                                <tr id="tableHeader">
                                    <!-- Headers will be inserted dynamically by JavaScript -->
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                <!-- Rows will be inserted dynamically by JavaScript -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="pagination-container border-top bg-light p-3" id="paginationContainer">
                        <div class="row align-items-center">
                            <div class="col-sm-6 mb-2 mb-sm-0">
                                <p class="text-muted small mb-0" id="pageInfo">
                                    Page 1 of 1
                                </p>
                            </div>
                            <div class="col-sm-6">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm justify-content-sm-end mb-0" id="paginationList">
                                        <!-- Pagination buttons will be inserted here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/views/reportdetails.js?ver=@DateTime.Now.Ticks"></script>
}