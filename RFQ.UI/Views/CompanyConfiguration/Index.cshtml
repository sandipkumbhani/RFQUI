@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
	Layout = "_Layout";
	ViewData["Title"] = "CompanyConfiguration";
}
@section Scripts {
	<script src="~/js/Views/CompanyConfiguration.js"></script>
}

<div id="listSection">
	<div class="row">
		<div class="col-12">
			<div class="page-title-box add">
				<h1 class="page-title">Company Configuration</h1>
				<div class="add-btn">
					<a href="#" id="btnAddconfiguration">
						<i class="ri-add-line"></i> <span>Add</span>
					</a>
				</div>
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-12">
			<div class="card com-profile-info">
				<!-- Top Header -->
				<div class="table-top-header">
					<h4>List of CompanyConfiguration</h4>
					<div class="d-flex gap-2">
						<div class="table-search-box">
							<input type="text" id="customSearch" class="form-control form-control-sm" placeholder="Search...">
							<button type="submit"><i class="ri-search-line"></i></button>
						</div>
						@* <div class="dropdown">
							<button class="btn-btn-outline-secondary dropdown-toggle" type="button" id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
								Filter <i class="ri-sound-module-line"></i>
							</button>
							<ul class="dropdown-menu" aria-labelledby="filterDropdown">
								<li><a class="dropdown-item filter-option" data-value="">All Status</a></li>
								<li><a class="dropdown-item filter-option" data-value="Pending">Pending</a></li>
								<li><a class="dropdown-item filter-option" data-value="Done">Done</a></li>
							</ul>
						</div> *@
						<div id="exporttableCC" class="btn-group" role="group"></div>
					</div>
				</div>
				<!-- Table -->
				<div class="table-responsive">
					<table id="tableCmpConfig"
						   class="table dt-responsive nowrap w-100">
						<thead>
							<tr class="text-center">
								<th class ="text-center">Company</th>
								@* <th class="text-center">SMSProvider</th> *@
								<th class="text-center">SMSAuthKey</th>
								<th class ="text-center">WhatsAppAuthKey</th>
								@* <th class="text-center">WhatsAppProvider</th> *@
								<th class="text-center">SMTPHost</th>
								<th class="text-center">SMTPPort</th>
								<th class="text-center">SMTPUsername</th>
								<th class="text-center no-sort">Action</th>
							</tr>
						</thead>
						<tbody class="text-center">
							<!-- Dynamic rows go here -->
						</tbody>
					</table>
				</div>
				<!-- Bottom Area -->
				<div class="datatable-footer-bottom">
					<div class="totle-left">
						<span id="totalList">Total List: 3</span>
					</div>
					<div id="customPagination" class="dataTables_paginate paging_simple_numbers"></div>
					<input type="hidden" id="currentPage" value="1">
					<div class="show-page">
						<span>Show per page:</span>
						<select id="pageLength" class="form-select">
							<option value="5">5 </option>
							<option value="10" selected>10 </option>
							<option value="25">25</option>
						</select>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<div id="formSection" style="display: none;">
	<div class="row">
		<div class="col-12">
			<div class="page-title-box add">
				<h1 class="page-title">Add CompanyConfiguration</h1>
				<div class="add-breadcrumb">
					<nav aria-label="breadcrumb">
						<ol class="breadcrumb">
							<li class="breadcrumb-item">
								<a href="#" id="ListSectionLink">Company Configuration</a>
							</li>
							<li class="breadcrumb-item active" aria-current="page"> Add CompanyConfiguration</li>
						</ol>
					</nav>
				</div>
			</div>
		</div>
		<div id="addCompanyConfigDiv" class="card com-profile-info">
			<div class="top-details">
				<h2 class="page-form-title">CompanyConfiguration Details</h2>
				<form class="row all-custom-class" method="post" id="companyConfigurationForm">
					<!-- Row 1 -->
					<div class="col-lg-7">
						<div class="item-input">
							<label class="form-label">Company Name <span>*</span></label>
							<select class="select2-custom form-control" id="ddlCompany" style="width: 100%;">
							</select>
						</div>
					</div>
					<div class="col-lg-5"></div>
					<div class="col-lg-7">
						<div class="item-input">
							<label class="form-label">SMS Provider <span>*</span></label>
							<select class="select2-custom form-control" id="ddlSmsProvider" style="width: 100%;">
							</select>
						</div>
					</div>
					<div class="col-lg-5">
						<div class="item-input">
							<label class="form-label">SMS Authorization Key <span>*</span></label>
							<input id="txtSmsAuthKey" type="text" class="form-control" maxlength="200" />
						</div>
					</div>
					<div class="col-lg-7">
						<div class="item-input">
							<label class="form-label">WhatsApp Provider <span>*</span></label>
							<select class="select2-custom form-control" id="ddlWhatsappProvider" style="width: 100%;">
							</select>
						</div>
					</div>
					<div class="col-lg-5">
						<div class="item-input">
							<label class="form-label">WhatsApp Authorization Key <span>*</span></label>
							<input type="text" id="txtWhatsappAuthKey" class="form-control" maxlength="200" />
						</div>
					</div>
					<div class="col-lg-7">
						<div class="item-input">
							<label class="form-label">SMTP Host <span>*</span></label>
							<input type="text" id="txtSmtpHost" class="form-control" onkeypress="return AllowAlphaNumericOnly(event)" maxlength="50" />
						</div>
					</div>
					<div class="col-lg-5">
						<div class="item-input">
							<label class="form-label">SMTP Port <span>*</span></label>
							<input type="text" id="txtSmtpPort" class="form-control" onkeypress="return isNumber(event)" />
						</div>
					</div>
					<div class="col-lg-7">
						<div class="item-input">
							<label class="form-label">SMTP User Name <span>*</span></label>
							<input type="text" id="txtSmtpUserName" class="form-control " readonly="readonly" maxlength="50"
								   onfocus="if (this.hasAttribute('readonly')) {this.removeAttribute('readonly');}">
						</div>
					</div>
					<div class="col-lg-5">
						<div class="item-input">
							<label class="form-label">SMTP Password <span>*</span></label>
							<input type="password" id="txtSmtpPassword" class="form-control" readonly="readonly" maxlength="50"
								   onfocus="if (this.hasAttribute('readonly')) {this.removeAttribute('readonly');}">
						</div>
					</div>
				</form>
			</div>
			<div class="button-main">
				<a href="#" class="card-link" id="btnSaveForm" type="button" data-action="save">
					<i class="ri-save-line"></i>
					<span>
						Save
					</span>
				</a>
				<a href="#" class="card-link" data-action="saveNew" id="btnSaveAndNewForm">
					<i class="ri-save-line"></i>
					<span>
						Save & New
					</span>
				</a>
				<a href="#" class="card-link" id="btnUpdate" style="display:none;">
					<i class="ri-save-line"></i>
					<span>
						Update
					</span>
				</a>
				<a href="#" class="card-link" id="btnCancel">
					<i class="ri-close-line"></i>
					<span>
						Cancel
					</span>
				</a>
			</div>
		</div>
	</div>
</div>
