@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "CompanyConfiguration";
}
@section Scripts {
    <script src="~/js/Views/CompanyConfiguration.js"></script>
}

<div class="app-toolbar  pt-3 px-lg-3">
    <div class="app-container  container-fluid d-flex flex-stack flex-wrap">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex align-items-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-primary lh-1 fw-bolder fs-2x my-0 me-5">
                    Overview
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold">
                    <li class="breadcrumb-item text-gray-700 fw-bold lh-1">
                        <a href="#" class="text-gray-500"><i class="fa-solid fa-house"></i></a>
                    </li>
                    <li class="breadcrumb-item"><i class="fa-solid fa-chevron-right fs-4 text-gray-700 mx-n1"></i></li>
                    <li class="breadcrumb-item text-primary">
                        CompanyConfigration
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="app-content  px-lg-3">
    <div class="app-container  container-fluid">
        <div class="container my-4">
            <button id="backButton" type="button" class="btn btn-primary" style="display:none">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left-circle-fill" viewBox="0 0 16 16">
                    <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z"></path>
                </svg>
                Back
            </button>
        </div>
        <div id="AddCompnyConfigDiv" class="card">
            <div class="card-header border-0 cursor-pointer">
                <div class="card-title m-0">
                    <h3 class="fw-bold m-0">Company configuration</h3>
                </div>
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="company" class="form-label">Company</label>
                            <select name="company" id="company" class="selectpicker" data-live-search="true" data-width="100%">
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="smsProvider" class="form-label">SMS Provider</label>
                            <select name="smsProvider" aria-label="Select a SMS Provider" id="smsProvider" class="selectpicker" data-live-search="true" data-width="100%">
                            </select>
                        </div>
                    </div>
                    <div class="row mb-5">
                        <div class="col-md-6">
                            <label for="whatsappProvider" class="form-label">WhatsApp Provider</label>
                          
                            <select name="whatsappProvider" aria-label="Select a Whatsapp Provider" id="whatsappProvider" class="selectpicker" data-live-search="true" data-width="100%">
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="smsAuthKey" class="form-label">SMS Authorization Key</label>
                            <input type="text" id="smsAuthKey" class="form-control">
                        </div>
                    </div>
                    <div class="row mb-5">
                        <div class="col-md-6">
                            <label for="whatsappAuthKey" class="form-label">WhatsApp Authorization Key</label>
                            <input type="text" id="whatsappAuthKey" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label for="smtpHost" class="form-label">SMTP Host</label>
                            <input type="text" id="smtpHost" class="form-control">
                        </div>
                    </div>
                    <div class="row mb-5">
                        <div class="col-md-6">
                            <label for="smtpUserName" class="form-label">SMTP User Name</label>
                            <input type="text" id="smtpUserName" class="form-control">
                        </div>
                        <div class="col-md-5">
                            <label for="smtpPort" class="form-label">SMTP Port</label>
                            <input type="text" id="smtpPort" class="form-control">
                        </div>
                        <div class="col-md-5">
                            <label for="smtpPassword" class="form-label">SMTP Password</label>
                            <input type="password" id="smtpPassword" class="form-control">
                        </div>
                    </div>
                    <button type="button" id="btnSaveForm" class="btn btn-primary me-2">Save</button>
                    <button type="button" id="btnSaveAndNewForm" class="btn btn-primary me-2">Save & New</button>
                    <button type="button" id="btnViewForm" class="btn btn-primary me-2">View</button>
                    <button type="button" id="btnUpdate" class="btn btn-primary" style="display:none">Update</button>
                    <button id="cancleButton" type="button" class="btn btn-danger ms-2 d-none">Cancle</button>
                </form>
            </div>
            
        </div>
        <div class="my-4"></div>
        <div id="tableDiv" class="card card-flush shadow-sm rounded-2xl d-none">
            <div class="card-header p-4">
                <h4 class="fw-bold align-middle m-0 text-lg"> Company Configuration List</h4>
            </div>
            <div class="card-body">
                <table id="tableCmpConfig" class="table table-striped align-middle fs-6 mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Company</th>
                            <th>SMSProvider</th>
                            <th>SMSAuthKey</th>
                            <th>WhatsAppAuthKey</th>
                            <th>WhatsAppProvider</th>
                            <th>SMTPHost</th>
                            <th>SMTPPort</th>
                            <th>SMTPUsername</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Dynamic rows go here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
