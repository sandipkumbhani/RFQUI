@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "ProfileRight";
}
@section Scripts {
    <script src="~/js/Views/ProfileRights.js"></script>
}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box add">
                <h1 class="page-title">Profile Rights Details</h1>
            </div>
        </div>
        <div id="AddProfileDiv" class="card com-franchise-info col-12">
            <form class="form" id="ProFileBodyForm" method="post">
                <input type="hidden" id="txtProfileId" />

                <div class="card-body p-9">
                    <h2 class="page-form-title">Profile Rights</h2>
                    <div class="row">
                        <div class="col-lg-6">
                            <label class="form-label">Profile Name: <span>*</span></label>
                            <select class="select2-custom form-control" style="width: 100%;" id="txtName">
                            </select>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label">Menu Group: <span>*</span></label>
                            <select class="select2-custom form-control" style="width: 100%;" id="txtMenu">
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card-body p-9">
                    <!-- Select All Checkbox -->
                    <div class="form-check mb-3">
                       @*  <input class="checkmark" type="checkbox" id="selectAll">
                        <label class="form-check-label" for="selectAll">Select All</label> *@
                    </div>
                    <!-- Menu Items -->

                    @* <div class="mb-3" id="menuItemList">
                </div> *@
                    <table class="table">
                        <thead>
                            <tr>
                                <th>
                                    Administrator Acces
                                </th>
                                <th class="text-center">View</th>
                                <th class="text-center">Add</th>
                                <th class="text-center">Edit</th>
                                <th class="text-center">Cancel</th>
                            </tr>
                        </thead>
                        <tbody id="menuItemList">
                        </tbody>
                    </table>
                </div>

                <div class="button-main mt-3">
                    <a href="#" id="btnSaveForm" class="card-link" data-action="save">
                        <i class="ri-save-line"></i>
                        <span>Save</span>
                    </a>
                </div>
            </form>
        </div>

    </div>
</div>



