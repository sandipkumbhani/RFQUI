@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
	Layout = "_Layout";
	ViewData["Title"] = "ProfileRight";
}
@section Scripts {
	<script src="~/js/Views/ProfileRights.js"></script>
}

<div class="app-content px-lg-3">
	<div class="app-container container-fluid">
		<div class="card">
			<!-- Card Header -->
			<div class="card-header border-0 cursor-pointer">
				<div class="card-title m-0">
					<h3 class="fw-bold m-0">Profile Rights</h3>
				</div>
			</div>
			<!-- Profile Name Selection -->
			<div class="card-body border-top p-9">
				<div class="row">
					<div class="col-xl-6">
						<div class="mb-5">
							<label class="form-label">* Profile Name:</label>
							@* <select class="form-select"> *@
							@*     <option>Selection Box</option> *@
							@* </select> *@
							<select name="Name" aria-label="Select a One Name" id="txtName" class="selectpicker" data-live-search="true" data-width="100%">
							</select>
						</div>
					</div>
					<div class="col-xl-6">
						<div class="mb-5">
							<label class="form-label">* Menu Group:</label>
							@* <select class="form-select"> *@
							@*     <option>Selection Box</option> *@
							@* </select> *@
							<select name="Menu" aria-label="Select a One Menu" id="txtMenu" class="selectpicker" data-live-search="true" data-width="100%">
							</select>
						</div>
					</div>
				</div>
			</div>
			<div class="card-body p-9">
				<div class="row">
					<!-- Select All Checkbox -->
					<div class="form-check mb-5 ms-5">
						<input class="form-check-input" type="checkbox" id="selectAll">
						<label class="form-check-label" for="selectAll">Select All</label>
					</div>
					<!-- Menu Items -->

					<div class="mb-3" id="menuItemList">
					</div>

					<div class="card-footer d-flex justify-content-srtat py-6 px-9">
						<button type="button" id="btnSaveForm" class="btn btn-primary me-2">Save</button>
						<button type="button" id="btnSaveAndNewForm" class="btn btn-primary me-2">Save & New</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

