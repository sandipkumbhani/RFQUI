@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Franchise";
}
@section Scripts {
    <script src="~/js/AttachmentDetails.js"></script>
    <script src="~/js/Views/Franchise.js"></script>
}
<div id="tableDiv">
<div class="row">
    <div class="col-12">
        <div class="page-title-box add">
            <h1 class="page-title">Franchise</h1>

            <div class="add-btn">
                <a href="#" id="btnAddFranchise">
                    <i class="ri-add-line"></i> <span>Add</span>
                </a>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card com-profile-info">
            <!-- Top Header -->
            <div class="table-top-header">
                <h4>List of Franchise</h4>
                <div class="d-flex gap-2">
                    <div class="table-search-box">
                        <input type="text" id="customFranchiseSearch" class="form-control form-control-sm" placeholder="Search...">
                        <button type="submit"><i class="ri-search-line"></i></button>
                    </div>
                    @* <div class="dropdown">
                        <button class="btn-btn-outline-secondary dropdown-toggle" type="button" id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            Filter <i class="ri-sound-module-line"></i>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="filterDropdown">
                            <li><a class="dropdown-item filter-option" data-value="">All Status</a></li>
                            <li><a class="dropdown-item filter-option" data-value="Pending">Pending</a></li>
                            <li><a class="dropdown-item filter-option" data-value="Done">Done</a></li>
                        </ul>
                    </div> *@
                    <div id="exportFranchiseButtons" class="btn-group" role="group"></div>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                    <table id="franchiseTable" class="table dt-responsive nowrap w-100">
                        <thead>
                            <tr class="text-center">
                                <th class="text-center">Franchise Logo</th>
                                <th class="text-center">Franchise Name</th>
                                <th class="text-center">Address</th>
                                <th class="text-center">Email</th>
                                <th class="text-center">Contact Person</th>
                                <th class="text-center">Contact Number</th>
                                <th class="text-center">Mobile Number</th>
                                <th class="text-center">GST Number</th>
                                <th class=" text-center no-sort">Action</th>
                            </tr>
                        </thead>

                        <tbody class="text-center"></tbody> <!-- This will be dynamically filled -->
                    </table>
            </div>

            <!-- Bottom Area -->
            <div class="datatable-footer-bottom">
                <div class="totle-left">
                    <span id="totalList">Total List: 3</span>
                </div>
                <div id="customFranchisePagination" class="dataTables_paginate paging_simple_numbers"></div>
                <div class="show-page">
                    <span>Show per page:</span>
                    <select id="pageLength" class="form-select">
                        <option value="5">5 </option>
                        <option value="10" selected>10 </option>
                        <option value="25">25</option>
                    </select>
                </div>
            </div>

        </div>
    </div>
</div>
</div>
<div id="formDiv" style="display:none;">
<div class="row">
    <div class="col-12">
        <div class="page-title-box add">
            <h1 class="page-title">Add Franchise</h1>

            <div class="add-breadcrumb">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a id="tableDivLink" href="">Franchise</a></li>
                        <li class="breadcrumb-item active" aria-current="page"> Add Franchise</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card com-franchise-info">
            <form id="franchiseForm" class="" enctype="multipart/form-data" method="post">
                <input type="hidden" id="hdnCompanyId" />
                <div class="franchise-details">
                    <h2 class="page-form-title">Franchise Details</h2>
                    <div class=" all-custom-class">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">Franchise Name <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Enter Franchise Name" id="txtFranchiseName" maxlength="100" />
                                </div>
                                <div class="item-input">
                                    <label class="form-label">City <span>*</span></label>
                                        <select class="select2-custom form-control" style="width: 100%;" id="ddlCity">
                                        </select>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="file-upload-item">
                                    <label class="form-label">Franchise Logo <span>*</span></label>
                                        <div class="dropzone" id="dropzone">
                                        <div class="dz-message needsclick">
                                            <i class="ri-upload-cloud-2-fill"></i>
                                            <h5>Drag & Drop your files here</h5>
                                            <strong>OR</strong>
                                            <span>Browse files</span>
                                        </div>
                                    </div>
                                </div>
                                <input type="text" hidden id="hdnUploadedFile" />

                            </div>
                        </div>

                        <div class="col-lg-12">
                            <div class="item-input">
                                <label class="form-label">Address <span>*</span></label>
                                <input type="text" class="form-control" placeholder="Enter Your Address" id="txtAddress" maxlength="200" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">Contact Person <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Enter Contact Person" id="txtContactPerson" maxlength="50" onkeypress="return isAlphabets(event)" />
                                </div>
                                <div class="item-input">
                                    <label class="form-label">Contact Number <span>*</span></label>
                                        <input type="tel" class="form-control phone-input" placeholder="+1 (555) 000-0000" id="txtContactNumber" maxlength="10" onkeypress="return isNumber(event)" />
                                </div>
                                <div class="item-input">
                                    <label class="form-label">Mobile Number <span>*</span></label>
                                        <input type="tel" class="form-control phone-input" placeholder="+1 (555) 000-0000" id="txtMobileNumber" onkeypress="return isNumber(event)" maxlength="10" />
                                </div>
                                <div class="item-input">
                                    <label class="form-label">Pan Number <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="xxxxxxxxxx" id="txtPanNumber" maxlength="10" onkeypress="return AllowAlphaNumericOnly(event)" />
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="item-input">
                                    <label class="form-label">Pincode <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="Enter Your Pincode" id="txtPinCode" onkeypress="return isNumber(event)" maxlength="6" />
                                </div>
                                <div class="item-input">
                                    <label class="form-label">WhatsApp Number <span>*</span></label>
                                        <input type="tel" class="form-control phone-input" placeholder="+1 (555) 000-0000" id="txtWhatsAppNumber" onkeypress="return isNumber(event)" maxlength="10"/>
                                </div>
                                <div class="item-input">
                                    <label class="form-label">Email <span>*</span></label>
                                    <input type="email" class="form-control" placeholder="Enter Your Email" id="txtEmailId" maxlength="50" />
                                </div>
                                <div class="item-input">
                                    <label class="form-label">GST Number <span>*</span></label>
                                    <input type="text" class="form-control" placeholder="xxxxx-xxxxx-xxxxx" id="txtGstNumber" maxlength="15" onkeypress="return AllowAlphaNumericOnly(event)" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                @await Html.PartialAsync("~/Views/Partials/_AttachmentDetails.cshtml")
                <div class="button-main">
                        <a href="#" class="card-link" id="btnSaveFranchise">
                        <i class="ri-save-line"></i>
                        <span>
                            Save
                        </span>
                        </a>
                        <a href="#"  class="card-link" id="btnSavenewFranchise">
                        <i class="ri-save-line"></i>
                        <span>
                            Save & New
                        </span>
                    </a>
                        <a href="#" class="card-link" id="btnUpdateFranchise" style="display:none;margin-left:0px;">
                            <i class="ri-save-line"></i>
                            <span>
                                Update
                            </span>
                        </a>
                        <a href="#" class="card-link" id="btnCancel">
                        <i class="ri-close-line"></i>
                        <span>
                            Cancel
                        </span>
                        </a>
                </div>
            </form>
        </div>
    </div>
</div>
</div>