@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Franchise";
}
@section Scripts {
    <script src="~/js/Views/Franchise.js"></script>
}
<div class="app-toolbar  pt-3 px-lg-3">
    <div class="app-container  container-fluid d-flex flex-stack flex-wrap">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex align-items-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-primary lh-1 fw-bolder fs-2x my-0 me-5">
                    Dashboard
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold">
                    <li class="breadcrumb-item text-gray-700 fw-bold lh-1">
                        <a href="#" class="text-gray-500"><i class="fa-solid fa-house"></i></a>
                    </li>
                    <li class="breadcrumb-item"><i class="fa-solid fa-chevron-right fs-4 text-gray-700 mx-n1"></i></li>
                    <li class="breadcrumb-item text-primary">
                        Franchise
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="app-content  px-lg-3">
    <div class="app-container  container-fluid">
        <div class="container my-4">
            <button id="backButton" type="button" class="btn btn-primary" style="display:none">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left-circle-fill" viewBox="0 0 16 16">
                    <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z"></path>
                </svg>
                Back
            </button>
        </div>
        <div id="addFranchiseDiv" class="card">
            <div class="card-header border-0 cursor-pointer">
                <div class="card-title m-0">
                    <h3 class="fw-bold m-0">Franchise</h3>
                </div>
            </div>
            <form id="franchiseForm" class="form" enctype="multipart/form-data" method="post">
                <input type="number" hidden id="txtCompanyId"/>
                <div class="card-body border-top p-9">
                    <div class="row">
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Franchise Name </label>
                                <input type="text" class="form-control" placeholder="Franchise Name" id="txtFranchiseName" maxlength="100" />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Franchise Code</label>
                                <input type="text" class="form-control" placeholder="Franchise Code" id="txtFranchiseCode" onkeypress="return AllowAlphaNumericOnly(event)" />
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="fv-row upload-imgs">
                                <div class="dropzone" id="dropzone">

                                    <div class="dz-message needsclick">
                                        <i class="bi bi-cloud-upload fs-3x text-primary"></i>

                                        <div class="ms-4">
                                            <h3 class="fs-5 fw-bold text-gray-900 mb-1">Upload logo</h3>
                                        </div>

                                    </div>
                                </div>
                                
                            </div>
                            <input type="text" hidden id="txtUploadedFile" />
                        </div>
                        <div class="col-xl-12">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Address </label>
                                <input type="text" class="form-control" placeholder="Address" id="txtAddress" maxlength="200"/>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">City</label>

                                <select id="ddlCity" name="franchise" aria-label="Select a City" class="selectpicker" data-live-search="true" data-width="100%">
                                </select>
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Contact Person </label>
                                <input type="text" class="form-control" placeholder="Contact Person" id="txtContactPerson" onkeypress="return AllowAlphaNumericOnly(event)" maxlength="50"/>
                            </div>

                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Mobile Number</label>
                                <input type="text" class="form-control" placeholder="Mobile Number" id="txtMobileNumber" onkeypress="return isNumber(event)" maxlength="10"/>
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Pan Number</label>
                                <input oninput="this.value = this.value.toUpperCase()" type="text" class="form-control" placeholder="Pan Number" id="txtPanNumber" onkeypress="return AllowAlphaNumericOnly(event)" maxlength="10" />
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">Pincode</label>
                                <input type="text" class="form-control" placeholder="Pincode" id="txtPinCode" onkeypress="return isNumber(event)" maxlength="6" />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">WhatsApp Number</label>
                                <input type="text" class="form-control" placeholder="WhatsApp Number" id="txtWhatsAppNumber" onkeypress="return isNumber(event)" maxlength="10" />
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label fw-semibold fs-6">Email ID</label>
                                <input type="email" class="form-control" placeholder="name@example.com" id="txtEmailId"/>
                            </div>
                            <div class="mb-5">
                                <label class="form-label col-form-label required fw-semibold fs-6">GST Number</label>
                                <input oninput="this.value = this.value.toUpperCase()" type="text" class="form-control" placeholder="GST Number" id="txtGstNumber" onkeypress="return AllowAlphaNumericOnly(event)" maxlength="15" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body border-top p-9">
                    <div class="card-title m-0 pb-10">
                        <h3 class="fw-bold m-0">Attachment Details</h3>
                    </div>

                    <div id="kt_docs_repeater_basic">
                        <div class="form-group">
                            <div data-repeater-list="kt_docs_repeater_basic">
                                <div data-repeater-item>
                                    <div class="form-group row">
                                        <div class="col-md-2">
                                            <label class="form-label col-form-label fw-semibold fs-6">File Name</label>
                                            <input type="email" class="form-control mb-2 mb-md-0" placeholder="File Name" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label col-form-label fw-semibold fs-6">Attachment Type  </label>
                                            <select name="franchise" aria-label="Select a Attachment Type"
                                                    data-control="select2" data-placeholder="Select a Attachment Type" class="form-select select2 form-select-solid form-select-lg fw-semibold">
                                                <option value="">Select a Attachment Type</option>
                                                <option value="0">Afghanistan</option>
                                                <option value="1">Aland Islands</option>
                                                <option value="2">Albania</option>
                                                <option value="3">Algeria</option>
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label col-form-label fw-semibold fs-6">Choose File </label>
                                            <label class="input-group mb-3">
                                                <input class="visually-hidden" type="file">
                                                <span class="form-control">Choose File</span>
                                            </label>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label col-form-label fw-semibold fs-6">Upload  </label>
                                            <label class="input-group mb-3">
                                                <button type="button" class="btn btn-primary">Upload</button>
                                            </label>
                                        </div>
                                        <div class="col-md-4">
                                            <a href="javascript:;" data-repeater-delete class="btn btn-sm btn-light-danger mt-8 mt-md-8">
                                                <i class="bi bi-trash"></i>
                                                Delete
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group mt-5">
                            <a href="javascript:;" data-repeater-create class="btn btn-light-primary">
                                <i class="fa-solid fa-plus"></i>
                                Add
                            </a>
                        </div>
                    </div>

                </div>
                <div class="card-footer d-flex justify-content-srtat py-6 px-9">
                    <button id="btnSaveFranchise" type="button" class="btn btn-primary me-2">Save</button>
                    <button id="btnSavenewFranchise" type="button" class="btn btn-primary me-2">Save & New</button>
                    <button type="button" id="btnUpdateFranchise" class="btn btn-primary me-2" style="display:none;">Update</button>
                    <button type="button" class="btn btn-primary" id="btnViewButton">View</button>
                    <button id="cancleButton" type="button" class="btn btn-danger d-none">Cancle</button>
                </div>
            </form>
        </div>

        <div id="tableDiv" class="card card-flush shadow-sm rounded-2xl" style="display:none">
            <div class="card-header p-4">
                <h4 class="fw-bold m-0 text-lg">Franchise List</h4>
            </div>
            <div class="card-body">
                <table id="tableFranchise"
                       class="table table-striped align-middle fs-6 mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Logo</th>
                            <th>CompanyName</th>
                            <th>AddressLine</th>
                            <th>CityId</th>
                            <th>PinCode</th>
                            <th>ContactPerson</th>
                            <th>Contact No</th>
                            <th>Mobile No</th>
                            <th>WhatsApp No</th>
                            <th>Email</th>
                            <th>PAN No</th>
                            <th>GST No</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Dynamic rows go here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

