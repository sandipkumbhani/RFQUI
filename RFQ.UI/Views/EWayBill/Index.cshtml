@{
    Layout = "_Layout";
    ViewData["Title"] = "E-Way Bill Extension";
}
@section Scripts {
    <script src="~/js/Views/EWayBill.js"></script>
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box add">
            <h1 class="page-title">E-Way Bill Extension</h1>
        </div>
    </div>
    <div class="card com-profile-info">
        <div class="top-details">
            <form class="row all-custom-class" id="EWayBillExtensionForm" method="post">
                <div class="col-lg-6">
                    <div class="item-input">
                        <label class="form-label">E-Way Bill Expiry Date <span>*</span></label>
                        <div class="input-group">
                            <input type="text" id="txtEwayBill" class="form-control" placeholder="Server Date Display" oninput="this.value = this.value.toUpperCase()" onkeypress="return AllowAlphaNumericOnly(event)" maxlength="10" />
                            <button id="btnShowData" type="button" class="btn btn-primary ms-2">Show</button>
                        </div>
                    </div>
                </div>
                <div class="col-12 mt-3">
                    <h3 class="page-form-title">Trip Details</h3><hr>
                    <div class="table-responsive">
                        <table class="table dt-responsive nowrap w-100">
                            <thead>
                                <tr>
                                    <th class="text-center">Sr. No.</th>
                                    <th class="text-center">Select</th>
                                    <th class="text-center">Vehicle No</th>
                                    <th class="text-center">Booking No</th>
                                    <th class="text-center">Booking Date</th>
                                    <th class="text-center">Origin</th>
                                    <th class="text-center">Destination</th>
                                    <th class="text-center">Current Location</th>
                                    <th class="text-center">Current Pincode</th>
                                    <th class="text-center">Current State</th>
                                    <th class="text-center">Remaining Distance</th>
                                    <th class="text-center">Extension Reason</th>
                                    <th class="text-center">Extension Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Example Row -->
                                <tr>
                                    <td class="text-center">1</td>
                                    <td class="text-center"><input type="checkbox" /></td>
                                    <td><input type="text" class="form-control" /></td>
                                    <td><input type="text" class="form-control" /></td>
                                    <td><input type="date" class="form-control" /></td>
                                    <td><input type="text" class="form-control" /></td>
                                    <td><input type="text" class="form-control" /></td>
                                    <td><input type="text" class="form-control" /></td>
                                    <td><input type="number" class="form-control" /></td>
                                    <td>
                                        <select class="form-control select2-custom">
                                            <option>Select</option>
                                            <!-- Add state options dynamically -->
                                        </select>
                                    </td>
                                    <td><input type="number" class="form-control" /></td>
                                    <td>
                                        <select class="form-control select2-custom">
                                            <option>Select Reason</option>
                                            <!-- Add reason options dynamically -->
                                        </select>
                                    </td>
                                    <td><input type="text" class="form-control" /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </form>
        </div>
        <div class="button-main">
            <a href="#" class="card-link" id="btnSaveForm" type="button">
                <i class="ri-save-line"></i>
                <span>Save</span>
            </a>
            <a href="#" class="card-link" id="btnSaveAndNewForm" type="button">
                <i class="ri-save-line"></i>
                <span>Save & New</span>
            </a>
        </div>
    </div>
</div>